# --- Local, environment-specific configuration (never commit) ---
# Mirrors tests/check_no_local_files.sh, which explains each rule; the two must
# agree. Ansible loads group_vars/ and host_vars/ beside every inventory source
# and every playbook - deploy.yml at the root, the rest in playbooks/ - so these
# match at any depth, and tracked fixtures are re-included by name.
#
# Real inventories.
hosts.y*ml
hosts.json
hosts.ini
inventory/**/hosts
inventory/**/hosts.*
inventory/**/*.ini
inventory/**/*proxmox.y*ml
# A vars file of exactly that name under group_vars/ is not the plugin's config.
!inventory/**/group_vars/**/proxmox.y*ml
# Local and secret variable files.
**/group_vars/**/local*
**/group_vars/**/vault*
**/group_vars/**/secret*
host_vars/
!/molecule/*/host_vars/
local.y*ml
local.json
secret.y*ml
secret.json
secrets.y*ml
secrets.json
vault*.y*ml
vault*.json
# Credentials.
.vault_pass*
.env*
# Run logs (the Makefile's LOG_DIR): they name hosts and addresses.
.logs/
*.log
# A committed template carries no real values.
!*.example

# --- Python / tooling ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Ansible / Molecule ---
*.retry
.ansible/
.cache/
.molecule/
collections/ansible_collections/

# --- Vagrant ---
.vagrant/

# --- Editors / OS ---
.idea/
.vscode/
.DS_Store

# Working documents - plans, review reports, smoke runbooks and their renders -
# stay local to the author, beside the wiki in docs/, which is committed.
# zensical.toml's exclude_docs keeps them out of the site as well.
docs/plan-*
docs/review-*
docs/live-smoke-*
docs/*.html
docs/*.src
# The wiki built as a site (make docs-build, and the docs tests).
site/
