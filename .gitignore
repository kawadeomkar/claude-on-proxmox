.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Ansible / Molecule ---
*.retry
.ansible/
.cache/
.molecule/
collections/ansible_collections/

# --- Vagrant ---
.vagrant/
*.log

