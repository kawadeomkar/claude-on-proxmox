#!/bin/sh
# The checks the justfile's recipes run before their work, each saying what
# to do when it fails. They are lines of each recipe's own script rather than
# recipes it depends on, since JUST_NO_DEPS or --no-deps would skip a
# dependency.
#
#   tools/check checkout <directory>   just was started there: refuse another checkout
#   tools/check host <bin> env|list|switch|remove ...
#                                        the checkout's hosts (tools/host): the host of a run and the files it is
#                                        read from, or just host's list, switch and removal
#   tools/check vault <file>...        each vault exists and is encrypted
#   tools/check collections <bin>      the Galaxy collections are requirements.yml's pins
#   tools/check names <name>...        VM names: letters, digits and . _ - , only, from a letter or digit
#   tools/check size <cores> <memory> <disk>   deploy's size: whole numbers, memory M or G, disk G or T
#   tools/check project <name>         one repository folder's name
#   tools/check session <id>           one Claude Code session ID, or none
#   tools/check sections <list>        just status's sections, comma-separated, or none
#   tools/check lock <file> <pid> <title>   the run lock: one run that changes something at a time
#   tools/check unheld <file>          no live run holds the run lock
#   tools/check settings <bin> [--asking] <file>...
#                                        no setting under a name 1.0 renamed, in local.yml or hosts.yml, nor
#                                        one 2.1 removed with WireGuard; a name 1.1 gave a new one is still
#                                        read, and said; and no VPN chosen is said, but --asking (just init,
#                                        which asks)
set -eu
# The character sets below are spelt out rather than written as ranges, so
# no locale can widen them (a UTF-8 one may collate accented letters into
# A-Z), and none needs setting: ansible-galaxy refuses one that is not UTF-8.

case "${1:-}" in
checkout)
  # just looks for a justfile upward from where it was started and does not
  # stop at a checkout's .git: started in a worktree of a branch that has no
  # justfile - an older one, under .claude/worktrees/ - it runs this one, in
  # this directory, with this checkout's inventory and vault. A subdirectory
  # of this checkout, or a directory in none, is fine. This checkout is as git
  # spells it too, never as the shell's pwd: that keeps the case a directory was
  # typed in, which macOS's file system ignores, and a copy with no .git of its
  # own inside another work tree is that tree's for git on both sides.
  top=$(git -C "$2" rev-parse --show-toplevel 2>/dev/null || true)
  here=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if [ -n "$top" ] && [ "$top" != "$here" ]; then
    echo "error: just was started in $2, in the checkout $top, which has no justfile of its own;" >&2
    echo "this justfile is $(pwd -P)'s. Run the commands that checkout has there, or merge main into it." >&2
    exit 1
  fi
  ;;
host)
  # The one place that knows where a checkout's hosts are (lib/claude_vm/hosts/): the first in inventory/, each
  # other in hosts/<name>/. Run with the environment's Python (<bin>), which reads their YAML, and opens a vault only
  # to read the names it sets.
  bin=$2
  shift 2
  test -x "$bin/python" || { echo "error: no python in [$bin], the bin of the project's Python environment. Run: just install" >&2; exit 1; }
  exec "$bin/python" -I "$(dirname "$0")/host" "$@"
  ;;
vault)
  # Without vault.yml a playbook dies inside the cluster listing on an
  # undefined variable; plaintext, it would be used as it is. A run against a
  # host in hosts/ reads two: the shared one, and the host's.
  shift
  for file in "$@"; do
    # A host's own, in hosts/<name>/, is made and edited for that host.
    folder=${file%/group_vars/all/vault.yml} host=
    case "$folder" in "$file" | inventory | */inventory) ;; *) host=" --host ${folder##*/}" ;; esac
    test -f "$file" || { echo "error: $file missing. Run: just init$host" >&2; exit 1; }
    head -c 14 "$file" | grep -q '^\$ANSIBLE_VAULT' || { echo "error: $file is not encrypted. Run: just vault$host" >&2; exit 1; }
  done
  ;;
collections)
  # Each checkout has its own collections (tools/env-run --collections, which
  # the recipe exports as ANSIBLE_COLLECTIONS_PATH), but a pull that bumped a
  # pin would leave the runs on the version installed before it, without a
  # word. --offline resolves against what is installed and contacts nothing:
  # with every pin installed it changes nothing, and otherwise fails.
  test -x "$2/ansible-galaxy" || { echo "error: no ansible-galaxy in [$2], the bin of the project's Python environment. Run: just install" >&2; exit 1; }
  "$2/ansible-galaxy" collection install -r requirements.yml --offline </dev/null >/dev/null 2>&1 \
    || { echo "error: the installed Galaxy collections are not the ones requirements.yml pins. Run: just install" >&2; exit 1; }
  ;;
names)
  # just has held each name to its pattern already; this holds the JSON the
  # names go into whatever the justfile's assignments were overridden to.
  shift
  for name in "$@"; do
    # A name starts as a DNS name does, with a letter or a digit: a word that
    # starts with - is an option, which a recipe without options takes as a word.
    # An underscore passes: the recipe puts a hyphen in its place (hyphenate_names).
    case "$name" in
    '' | [!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789]* | *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._,-]*)
      echo "error: VM names start with a letter or a digit and may contain only letters, digits and . _ - , (got: [$name])" >&2
      exit 1
      ;;
    esac
  done
  ;;
size)
  # deploy's --cores, --memory and --disk: just has held each to its pattern
  # already; this holds the JSON they go into, as names does. Cores are 1 to
  # 999, memory MiB or with M or G, a disk G or T, each a whole number.
  whole() {
    case "$1" in '' | 0* | *[!0123456789]*) return 1 ;; esac
    [ "${#1}" -le "$2" ]
  }
  [ -z "$2" ] || whole "$2" 3 || { echo "error: --cores is a number of cores, as 8 (got: [$2])" >&2; exit 1; }
  if [ -n "$3" ]; then
    case "$3" in *[MG]) memory=${3%?} ;; *) memory=$3 ;; esac
    whole "$memory" 7 || { echo "error: --memory is MiB, as 3072, or takes M or G, as 16G (got: [$3])" >&2; exit 1; }
  fi
  if [ -n "$4" ]; then
    case "$4" in *[GT]) disk=${4%?} ;; *) disk= ;; esac
    whole "$disk" 6 || { echo "error: --disk takes G or T, as 64G (got: [$4])" >&2; exit 1; }
  fi
  ;;
repos)
  # deploy's --repos: just has held it to its pattern already; this holds the
  # JSON it goes into, as names does. GitHub repository names, comma-separated:
  # each starts with a letter, a digit or _ (a dot would make a folder of
  # settings on the VM) and has at most 100 characters.
  if [ -n "$2" ]; then
    said="error: --repos names GitHub repositories, comma-separated: each starts with a letter, a digit or _, and has at most 100 letters, digits, . _ and - (got: [$2])"
    case ",$2," in
    *,,* | *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._,-]*)
      echo "$said" >&2
      exit 1
      ;;
    esac
    test "${#2}" -le 2000 || { echo "error: --repos is longer than the 2000 characters it may be" >&2; exit 1; }
    for repo in $(printf %s "$2" | tr , ' '); do
      case "$repo" in [.-]*) echo "$said" >&2; exit 1 ;; esac
      test "${#repo}" -le 100 || { echo "$said" >&2; exit 1; }
    done
  fi
  ;;
project)
  # A GitHub repository name: at most 100 ASCII letters, digits, ".", "-" and
  # "_". So nothing outside the projects directory and nothing nested, and not
  # "." or "..", which name the directory itself or its parent.
  case "$2" in
  *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-]*)
    echo "error: --project may contain only letters, digits and . _ - (got: [$2])" >&2
    exit 1
    ;;
  . | ..)
    echo "error: --project names one project folder, not [$2]" >&2
    exit 1
    ;;
  esac
  test "${#2}" -le 100 || { echo "error: --project is longer than the 100 characters a repository name can be" >&2; exit 1; }
  ;;
session)
  # A Claude Code session ID, as Claude Code names a transcript: 32 lowercase
  # hex digits in groups of 8-4-4-4-12. Empty is none: the folder's latest
  # conversation continues.
  h='[0123456789abcdef]'
  case "$2" in
  '' | $h$h$h$h$h$h$h$h-$h$h$h$h-$h$h$h$h-$h$h$h$h-$h$h$h$h$h$h$h$h$h$h$h$h) ;;
  *)
    echo "error: --session is a Claude Code session ID such as 0a608ad8-1b2c-4d3e-8f90-123456789abc, as /resume lists it (got: [$2])" >&2
    exit 1
    ;;
  esac
  ;;
lock | unheld)
  # The run lock: a record of the recipe's script that holds it - its pid,
  # which the script keeps as it execs into the run, the start of that
  # process, the run's title - written O_EXCL (set -C). It is the holder's
  # while that pid still runs the process of that start, and taken over once
  # it does not, whatever ended it, never by age; a pid reused by another
  # process has another start. Never an fd lock: the run's children (ssh's
  # ControlPersist masters, an editor just code starts) would inherit it and
  # hold it. A recipe run inside the holder's (just init's install) is the
  # holder's own, found among this process's ancestors, and takes none. An
  # empty <file> is no lock (RUN_LOCK=).
  file=$2
  [ -n "$file" ] || exit 0
  # A process's start as ps says it, in C and UTC with its spaces collapsed:
  # read in the locale and zone of the run that reads it, or with the padding
  # macOS's ps adds, one process's start would read as two, and a held lock
  # as free. The MCP server reads it alike (jobs.started).
  start_of() {
    LC_ALL=C TZ=UTC0 ps -o lstart= -p "$1" 2>/dev/null | awk '{ $1 = $1; print }'
  }
  # A record's holder, when that process still runs: its pid, its start and the run's title, one per line.
  holder() {
    [ -f "$file" ] || return 1
    pid=$(sed -n 1p "$file") since=$(sed -n 2p "$file") title=$(sed -n 3p "$file") job=$(sed -n 4p "$file")
    case "$pid" in '' | *[!0123456789]*) return 1 ;; esac
    [ -n "$since" ] && [ "$(start_of "$pid")" = "$since" ]
  }
  busy() {
    echo "error: just $title is running (pid $pid, started $since UTC${job:+, MCP job $job}): one run that changes something at a time, from a terminal or an agent. Wait for it to end; just status says what the VMs are doing." >&2
    exit 1
  }
  if [ "$1" = unheld ]; then
    ! holder || busy
    exit 0
  fi
  me=$3 title_given=$4
  since_given=$(start_of "$me")
  mkdir -p "$(dirname "$file")"
  for attempt in 1 2 3; do
    if (set -C; printf '%s\n%s\n%s\n%s\n' "$me" "$since_given" "$title_given" "${AGENT_WAREHOUSE_JOB:-}" > "$file") 2>/dev/null; then
      exit 0
    fi
    if holder; then
      ancestor=$me
      while [ -n "$ancestor" ] && [ "$ancestor" -gt 1 ]; do
        [ "$ancestor" != "$pid" ] || exit 0
        ancestor=$(ps -o ppid= -p "$ancestor" 2>/dev/null | tr -d ' ')
      done
      busy
    fi
    # Its process is gone: taken over - the record removed, and written anew
    # above - by one run at a time, mkdir being the mutex, and only while the
    # record is still there and its process still gone. Under the mutex no
    # other run removes it, so none can have written its own in its place
    # between that check and the removal; an empty record is one being
    # written, never taken over.
    if mkdir "$file.takeover" 2>/dev/null; then
      taken=
      if [ -s "$file" ] && ! holder; then
        rm -f "$file"
        taken=yes
      fi
      rmdir "$file.takeover"
      [ -z "$taken" ] || continue
    fi
    sleep 0.1
  done
  echo "error: the run lock $file could not be taken: remove it, and $file.takeover if it is there, once no just deploy, login, code, destroy, init or install runs" >&2
  exit 1
  ;;
sections)
  # The report's sections status's --only takes, comma-separated, or none for all
  # of them. just has held it to its pattern; this holds the JSON it goes into.
  case ",$2," in
  ,,) ;;
  *,,* | *[!abcdefghijklmnopqrstuvwxyz,-]*)
    echo "error: --only takes the report's sections, comma-separated: vms storage capacity access sign-ins system work (got: [$2])" >&2
    exit 1
    ;;
  esac
  for section in $(printf %s "$2" | tr , ' '); do
    case "$section" in
    vms | storage | capacity | access | sign-ins | system | work) ;;
    *)
      echo "error: the report has no section [$section]: its sections are vms storage capacity access sign-ins system work" >&2
      exit 1
      ;;
    esac
  done
  ;;
settings)
  # A setting 1.0 renamed (docs/guides/upgrading.md), still set in local.yml or
  # hosts.yml, would be read by nothing, without a word: each is named with the
  # name it has now. One set to "" or left empty sets nothing and passes. The
  # files are read as YAML by the environment's Python (<bin>): at the top of
  # local.yml, and in hosts.yml in every group's and host's vars. vault.yml is
  # encrypted here, so its vm_password is checked where Ansible reads it.
  # A choice's setting (vpn) set to a value that is none of its choices is
  # refused too, naming them: its rows are literal data in the defaults. So is
  # a setting 2.1 removed with WireGuard, and vpn: wireguard. Where the files
  # set neither vpn nor tailscale_enabled, since 2.1 no VPN is chosen: said, as
  # a warning, but where the caller asks the question itself (--asking).
  bin=$2
  shift 2
  asking=
  if [ "${1:-}" = --asking ]; then asking=1; shift; fi
  any=
  for file in "$@"; do [ ! -e "$file" ] || any=1; done
  [ -n "$any" ] || exit 0
  # The checkout first, whose inventory defaults name what 1.1 renamed and
  # each choice's members.
  ASKING=$asking
  export ASKING
  exec "$bin/python" -I - "$(dirname "$0")/.." "$@" << 'PYTHON'
import os
import re
import sys

import yaml

# Each old name: its name from 1.0, and what to do.
RENAMED = {
    "claude_remote_control": ("claude_code_remote_control", "rename it there"),
    "claude_login_args": ("claude_code_login_args", "rename it there"),
    "claude_login_timeout": ("claude_code_login_timeout", "rename it there"),
    "claude_login_approval_timeout": ("claude_code_login_approval_timeout", "rename it there"),
    "claude_vm_default_name": ("vm_default_name", "rename it there"),
    "vm_password": ("vault_vm_password", "it is a secret, so move it to vault.yml under that name, with just vault"),
}


# Each setting 2.1 removed with WireGuard (docs/guides/upgrading.md), still set in local.yml or hosts.yml, would
# be read by nothing, without a word. vpn_reach: lan, which changed nothing, is only warned of.
RETIRED = (
    "vpn_reach",
    "wireguard_hub",
    "wireguard_hub_network",
    "wireguard_vm_prefix",
    "wireguard_hub_public_key",
    "wireguard_hub_endpoint",
    "wireguard_keepalive",
    "wireguard_hub_instance",
    "wireguard_hub_cert_sha256",
)

# Each choice's setting checked here: the defaults' list of its members, and the values that are no member.
CHOICES = {"vpn": ("claude_vpns", ("none",))}


class Loader(yaml.SafeLoader):
    """YAML as Ansible writes it: a tag such as !vault is a value, never a key."""


Loader.add_multi_constructor("!", lambda loader, suffix, node: None)


def named_anew(root):
    """Each name 1.1 gave a new one, by its old name: a setting of the inventory defaults whose default is the old
    name's value and nothing else ("{{ old }}"), neither name a role's variable, which starts with its role's name.
    lib/claude_vm/wiring.py's named_anew finds the same pairs through the roles' argument_specs for just settings;
    this needs neither Ansible nor that package, since it runs before every recipe. Such a name is still read
    through 1.x, so a file that sets one is told, never refused: should the defaults not read, nothing is said,
    rather than every recipe refused."""
    try:
        roles = tuple(f"{entry.name}_" for entry in os.scandir(os.path.join(root, "roles")) if entry.is_dir())
        with open(os.path.join(root, "inventory", "group_vars", "all", "defaults.yml"), encoding="utf-8") as stream:
            defaults = yaml.load(stream, Loader=Loader)
        found = {}
        for name, value in defaults.items():
            old = re.fullmatch(r"\{\{\s*([a-z_][a-z0-9_]*)\s*\}\}", value) if isinstance(value, str) else None
            if old and old.group(1) in defaults and not name.startswith(roles) and not old.group(1).startswith(roles):
                found[old.group(1)] = name
        return found
    except Exception:  # whatever stops it: a warning missed, never a recipe refused
        return {}


NAMED_ANEW = named_anew(sys.argv[1])


def settings(data):
    """Each (name, value) a file sets: its top level, and an inventory group's vars and hosts, all the way down."""
    if not isinstance(data, dict):
        return
    for name, value in data.items():
        yield name, value
        if isinstance(value, dict) and value.keys() & {"hosts", "children", "vars"}:
            yield from group(value)


def group(data):
    if isinstance(data.get("vars"), dict):
        yield from data["vars"].items()
    for host in (data.get("hosts") or {}).values() if isinstance(data.get("hosts"), dict) else ():
        if isinstance(host, dict):
            yield from host.items()
    for child in (data.get("children") or {}).values() if isinstance(data.get("children"), dict) else ():
        if isinstance(child, dict):
            yield from group(child)


found = False
try:
    with open(os.path.join(sys.argv[1], "inventory", "group_vars", "all", "defaults.yml"), encoding="utf-8") as stream:
        DEFAULTS = yaml.load(stream, Loader=Loader) or {}
except (OSError, yaml.YAMLError):
    DEFAULTS = {}
chosen = False
for path in sys.argv[2:]:
    try:
        with open(path, encoding="utf-8") as stream:
            data = yaml.load(stream, Loader=Loader)
    except FileNotFoundError:
        continue
    except yaml.YAMLError as error:
        # Where, never what: the line could hold anything.
        mark = getattr(error, "problem_mark", None)
        where = f" at line {mark.line + 1}" if mark else ""
        print(f"error: {path} is not YAML{where}, so it could not be checked for renamed settings", file=sys.stderr)
        found = True
        continue
    except OSError as error:
        print(f"error: {path} could not be read ({error.strerror}), so it could not be checked for renamed settings",
              file=sys.stderr)
        found = True
        continue
    named = {name for name, _ in settings(data)}
    chosen = chosen or bool(named & {"vpn", "tailscale_enabled"})
    for name, value in settings(data):
        if name in NAMED_ANEW and value not in ("", None):
            if NAMED_ANEW[name] in named:
                # The new name is the one read: the old one beside it changes nothing.
                print(f"warning: {path} sets both {name} and {NAMED_ANEW[name]}: {NAMED_ANEW[name]} is the one "
                      f"used, and {name} is ignored, so take it out (docs/guides/upgrading.md)", file=sys.stderr)
            else:
                print(f"warning: {path} sets {name}, which 1.1 calls {NAMED_ANEW[name]}: it is still read, but "
                      "rename it there (docs/guides/upgrading.md)", file=sys.stderr)
        if name == "vpn" and value == "wireguard":
            print(f"error: {path} sets vpn to wireguard, which 2.1 removed: a VPN that routes your LAN reaches the "
                  "VMs with vpn: none (docs/guides/upgrading.md)", file=sys.stderr)
            found = True
        elif name in CHOICES and value not in ("", None) and not (isinstance(value, str) and "{{" in value):
            rows, also = CHOICES[name]
            members = [*sorted(DEFAULTS.get(rows) or {}), *also]
            if not isinstance(value, str) or value not in members:
                # Never the value said back: it is one line of the user's file. A boolean is YAML's reading of an
                # unquoted on, yes or true, which would make the setting "True": no choice, and Tailscale off.
                why = " (YAML reads an unquoted on, off, yes, no, true or false as a boolean)" if isinstance(
                    value, bool) else ""
                print(f"error: {path} sets {name} to something that is none of its choices{why}: "
                      f"{', '.join(members)}", file=sys.stderr)
                found = True
        if name == "vpn_reach" and value == "lan":
            print(f"warning: {path} sets vpn_reach, which 2.1 removed with WireGuard: lan changed nothing, so take it "
                  "out (docs/guides/upgrading.md)", file=sys.stderr)
        elif name in RETIRED and value not in ("", None):
            print(f"error: {path} sets {name}, which 2.1 removed with WireGuard: take it out "
                  "(docs/guides/upgrading.md)", file=sys.stderr)
            found = True
        if name in RENAMED and value not in ("", None):
            new, what = RENAMED[name]
            print(f"error: {path} sets {name}, which is {new} from 1.0: {what} (docs/guides/upgrading.md)",
                  file=sys.stderr)
            found = True
# No VPN chosen anywhere: since 2.1 that is none, where it was Tailscale. Said once, naming the file a person sets it
# in; never by just init, which asks the question itself.
if not chosen and not os.environ.get("ASKING") and any(os.path.exists(path) for path in sys.argv[2:]):
    local = next((path for path in sys.argv[2:] if path.endswith("local.yml")), sys.argv[-1])
    print(f"warning: {local} sets no vpn: since 2.1 that is none - no VM gets Tailscale, and a VM it is on keeps it,"
          " unmanaged. Set vpn: tailscale or vpn: none to choose, or answer just init's question (docs/guides/"
          "upgrading.md)", file=sys.stderr)
sys.exit(1 if found else 0)
PYTHON
  ;;
*)
  echo "usage: tools/check checkout <directory> | host <bin> <action> ... | vault <file>... | collections <bin> | names <name>... | project <name> | session <id> | sections <list> | settings <bin> <file>... | lock <file> <pid> <title> | unheld <file>" >&2
  exit 2
  ;;
esac
