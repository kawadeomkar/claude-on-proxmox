{#- Rendered by docsible (docsible --md-template) for tools/docs.py, which writes it between the role page's
    markers. docsible passes `role` (its argument_specs, the raw tasks of each file under `mermaid`) and
    `mermaid_code_per_file` (its flowchart of each task file).

    An entry point other than main lists the variables it adds, and those it describes in a way of its own;
    the rest it shares with main are named in one line. tools/docs.py escapes the text, fills in
    @@no-default@@ from the role's defaults/main.yml, puts the internal values at @@internals@@, and an em
    space at each @@indent@@ (a task inside a block), after the escaping, which would show it as text. -#}
{%- set specs = (role.argument_specs or {}).get('argument_specs') or {} %}
{%- set main_options = specs.get('main', {}).get('options') or {} %}
{%- macro value(v) -%}
{%- if v is sameas true -%}`true`{%- elif v is sameas false -%}`false`
{%- elif v is none -%}`null`
{%- elif v is string and not v -%}`""`
{%- elif v is string and '{{' in v -%}computed
{%- else -%}
{%- set text = v if v is string else (v | tojson) -%}
{%- if '|' in text -%}<code>{{ text | replace('&', '&amp;') | replace('<', '&lt;') | replace('|', '&#124;') }}</code>
{%- else -%}`{{ text }}`{%- endif -%}
{%- endif -%}
{%- endmacro %}
{%- macro type(details) -%}
{%- set t = details.type | default('str') -%}
{%- if t == 'list' -%}list of `{{ details.elements | default('str') }}`{%- else -%}{{ t }}{%- endif -%}
{%- endmacro %}
{%- macro row(name, details) -%}
{%- set description = (details.description | default('', true)) -%}
{%- set description = description | join(' ') if description is not string else description -%}
| `{{ name }}` | {{ type(details) }} | {% if 'default' in details %}{{ value(details.default) }}{% else %}@@no-default@@{% endif %} | {% if details.required %}**Required.** {% endif %}{{ description | replace('\n', ' ') | replace('|', '\\|') }}{% if details.choices %} One of {% for c in details.choices %}`{{ c }}`{{ ', ' if not loop.last }}{% endfor %}.{% endif %}{% if details.no_log %} A secret: never logged.{% endif %} |
{%- endmacro %}
{%- macro table(options) -%}
| Variable | Type | Default | Description |
|---|---|---|---|
{%- for name, details in options.items() %}
{{ row(name, details) }}
{%- endfor %}
{%- for name, details in options.items() if details.options is defined %}

#### Options of `{{ name }}`

{{ table(details.options) }}
{%- endfor %}
{%- endmacro %}
{%- for entrypoint, spec in specs.items() %}

## Entry point `{{ entrypoint }}`

**{{ spec.short_description }}**
{%- if spec.description is defined %}
{% for line in ([spec.description] if spec.description is string else spec.description) %}
{{ line }}
{% endfor %}
{%- endif %}
{%- set options = spec.options | default({}, true) %}
{%- if entrypoint == 'main' %}
{%- if options %}

{{ table(options) }}
{%- else %}

This entry point takes no variables.
{%- endif %}
{%- else %}
{%- set own = {} %}
{%- set shared = [] %}
{%- for name, details in options.items() %}
{%- if name in main_options and (details.description | default('', true)) in ('', main_options[name].description | default('', true)) %}
{%- set _ = shared.append(name) %}
{%- else %}
{%- set _ = own.update({name: details}) %}
{%- endif %}
{%- endfor %}
{%- if own %}

{{ table(own) }}
{%- endif %}
{%- if shared %}

Also takes, as described under `main`: {% for name in shared %}`{{ name }}`{{ ', ' if not loop.last }}{% endfor %}.
{%- endif %}
{%- if not options %}

This entry point takes no variables.
{%- endif %}
{%- endif %}
{%- endfor %}

@@internals@@

## Tasks

Every task in `roles/{{ role.name }}/tasks/`, file by file, in the order the file lists them, with a flowchart of
each file. Generated from the task files, so a task added, renamed or removed shows here on the next `just docs`.
{#- Parameters that are not the task's module, so the first key outside them is. #}
{%- set known = ['action', 'any_errors_fatal', 'args', 'async', 'become', 'become_exe', 'become_flags',
    'become_method', 'become_user', 'changed_when', 'check_mode', 'collections', 'connection', 'debugger', 'delay',
    'delegate_facts', 'delegate_to', 'diff', 'environment', 'failed_when', 'ignore_errors', 'ignore_unreachable',
    'local_action', 'loop', 'loop_control', 'module_defaults', 'name', 'no_log', 'notify', 'poll', 'port',
    'register', 'remote_user', 'retries', 'run_once', 'tags', 'throttle', 'timeout', 'until', 'vars', 'when',
    'block', 'rescue', 'always', 'listen'] %}
{%- macro module(task) -%}
{%- if task.block is defined -%}block
{%- elif task.action is defined -%}`{{ task.action if task.action is string else (task.action.keys() | first) }}`
{%- else -%}
{%- for key in task.keys() if key not in known and not key.startswith('with_') -%}
{%- if loop.first -%}`{{ key }}`{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- endmacro %}
{%- macro when(task) -%}
{%- if task.when is defined and task.when is not none -%}
{%- set w = task.when -%}
{%- set text = (w | join(' and ')) if (w is iterable and w is not string) else (w | string) -%}
<code>{{ text | replace('\n', ' ') | replace('&', '&amp;') | replace('<', '&lt;') | replace('|', '&#124;') }}</code>
{%- endif -%}
{%- endmacro %}
{%- macro rows(tasks, stem, depth) -%}
{%- for task in tasks if task is mapping %}
{%- set name = task.name | default('(no name)') | string %}
{%- set name = name[stem | length + 3:] if name.startswith(stem ~ ' | ') else name %}
| {{ '@@indent@@' * depth }}{{ name | replace('|', '\\|') }} | {{ module(task) }} | {{ when(task) }} |
{%- for part in ['block', 'rescue', 'always'] if task[part] is defined and task[part] %}
{%- if part != 'block' %}
| {{ '@@indent@@' * (depth + 1) }}*{{ part }}:* | | |
{%- endif %}
{{- rows(task[part], stem, depth + (1 if part == 'block' else 2)) }}
{%- endfor %}
{%- endfor %}
{%- endmacro %}
{%- macro task_file(tf) %}

