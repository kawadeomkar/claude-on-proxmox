#!/bin/sh
# Run one of the project's tools from its Python environment - the virtualenv
# ${PYTHON:-python3} is, found the way the Makefile finds it - and never from
# PATH or a Python that is no virtualenv's. The git hooks run the linters
# through this, so a commit made from any shell or editor uses the versions
# uv.lock pins, or stops and says why.
#
#   tools/env-run yamllint --strict inventory/group_vars/all/defaults.yml
set -eu
python=${PYTHON:-python3}
bin=$("$python" -c 'import sys, sysconfig; print(sysconfig.get_path("scripts") if sys.prefix != sys.base_prefix else "")' 2>/dev/null) || bin=
if [ -z "$bin" ]; then
  echo "error: [$python] is not the Python of a virtualenv, and this project runs its tools only from one of its" >&2
  echo "own. Commit from a shell where python3 is that environment's (pyenv local does it), or set PYTHON." >&2
  exit 1
fi
if [ "$#" -eq 0 ]; then
  echo "usage: tools/env-run <tool> [argument...]" >&2
  exit 2
fi
tool=$1
shift
if [ ! -x "$bin/$tool" ]; then
  echo "error: no $tool in [$bin]. Run: make install" >&2
  exit 1
fi
exec "$bin/$tool" "$@"
