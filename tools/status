#!/usr/bin/env python3
"""just status: what every VM this project created is doing, and what needs doing next, changing nothing.

    "$bin/python" tools/status [--names <a,b>] [--only <sections>] [--json] [--cache <dir>]
                               [--vault-file <file>]... [--vault-password-file <file>] [-i <inventory>]... [-e <vars>]
                               [--private-key <file>]

The engine (lib/claude_vm/status/engine.py) reads and draws; this says what it was given. -e, -i and --private-key are
ANSIBLE_ARGS' (or a test's), and any other of those is warned of and ignored: just status runs no playbook.
--ask-vault-pass is refused, since it draws at once and asks nothing. Exits with the report's code: 0 nothing is wrong,
1 a problem, 2 something could not be read, 3 the run itself failed.
"""

from __future__ import annotations

import argparse
import os
import signal
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "lib"))  # the controller's package (docs/architecture/custom-code.md §7.10)
from claude_vm.status import engine  # noqa: E402


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--names", default="")
    parser.add_argument("--only", default="")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--cache", default="")
    # The shared vault, then a host's own in hosts/ (tools/check host): one --vault-file each, in that order.
    parser.add_argument("--vault-file", action="append", default=[])
    parser.add_argument("--vault-password-file", default="")
    parser.add_argument("-i", "--inventory", action="append", default=[])
    parser.add_argument("-e", "--extra-vars", dest="extra", action="append", default=[])
    parser.add_argument("--private-key", "--key-file", dest="private_key", default="")
    parser.add_argument("-J", "--ask-vault-password", "--ask-vault-pass", dest="ask_vault", action="store_true")
    opts, ignored = parser.parse_known_args(argv)
    if opts.ask_vault:
        # Warned of and ignored like the rest, the run would only fail later, for want of the password.
        print(
            "just status: --ask-vault-pass is refused: status draws at once and asks nothing. Put the vault's password"
            " in .vault_pass, or name a file that holds it in ANSIBLE_VAULT_PASSWORD_FILE.",
            file=sys.stderr,
        )
        return 3
    opts.private_key = os.path.abspath(os.path.expanduser(opts.private_key)) if opts.private_key else ""
    if ignored:
        print(f"just status: ignoring {' '.join(ignored)}: it runs no playbook", file=sys.stderr)
    # As a Ctrl-C, which ends every connection; never whatever SIGINT is now, which a run started with & has ignored.
    signal.signal(signal.SIGTERM, signal.default_int_handler)
    os.umask(0o077)
    return engine.run(opts)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
