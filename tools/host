#!/usr/bin/env python3
"""The checkout's hosts (lib/claude_vm/hosts/): which host a run is against, and the files and inventory it reads that
host from; just host's list, its switch and its removal. tools/check host runs it with the environment's Python.

    tools/host env --checkout <dir> --hosts-dir <dir> --vault-file <file> --settings-files <files> --vault-pass <file>
                   [--host <name>] [--nested <name>] [--names <a,b>] [--lenient] [--read-only]
    tools/host list --checkout <dir> --hosts-dir <dir> [--json]
    tools/host switch --checkout <dir> --hosts-dir <dir> <name>
    tools/host remove --checkout <dir> --hosts-dir <dir> <name>
    tools/host init --checkout <dir> --hosts-dir <dir> --vault-pass <file> [--address <address>] [--asking] [--shared]
                    [--secret-file] [<name>]
    tools/host current --checkout <dir> --hosts-dir <dir>
    tools/host every --checkout <dir> --hosts-dir <dir> [--except <name>] [--vault-file <file>] [--vault-pass <file>]

env prints, for the recipe to eval, the host of the run - --host, else the host --nested names (a recipe run inside
another's, its host passed as the justfile's nested_host=), else the one the VMs named are on, as their SSH aliases
record, else the one hosts/current names, else the first host - as shell assignments: host, hosts_many,
settings_files, vault_files, host_sources (each a -i of the run's, for a host in hosts/), host_extra and host_unplaced.
Or it refuses, saying why on standard error, and exits 1, before anything starts. Every value it prints is held to a
pattern first, and printed quoted. With --lenient, as just settings and just vault ask it, a host that lacks a setting
it sets for itself is taken, and what a run would read of it is not checked: they are how that is put right. With
--read-only, as just status asks it, nothing is written, hosts/.checked.json included.

init sets up a host for just init, from tools/templates/host/: its folder and each file it lacks, the hosts.yml naming
it; then prints what just init's playbooks are pointed at - its files, the vault's name for its token, what it sets for
itself - as JSON, for the recipe to pass on, with its inventory sources. Without a name, the current host's, as every
command's: the first host's until another is chosen. A host is never created without an address given or a terminal
to ask for one, nor at all while the checkout has no other: there, a bare word was 2.4's address.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "lib"))  # the controller's package (docs/architecture/custom-code.md §7.10)
from claude_vm import wire  # noqa: E402
from claude_vm.hosts import layout as hosts  # noqa: E402

TEMPLATES = REPO / "tools" / "templates" / "host"

# An address a host's hosts.yml gives it, as it may reach a run: a host name or an IP address, one word.
ADDRESS = re.compile(r"[A-Za-z0-9][A-Za-z0-9.:_-]{0,252}")
# Where just init reads the token's secret from, but for --token-secret-file: the name from 2.0, then 1.x's.
SECRET_VARIABLES = ("AGENT_WAREHOUSE_TOKEN_SECRET", "CLAUDE_ON_PROXMOX_TOKEN_SECRET")


def _refuse(said: str) -> int:
    print(f"error: {said}", file=sys.stderr)
    return 1


def _password_files(given: str) -> list[str]:
    """The vault's password files, as Ansible tries them: the recipe's, then ANSIBLE_VAULT_PASSWORD_FILE's."""
    files = [given, os.path.expanduser(os.environ.get("ANSIBLE_VAULT_PASSWORD_FILE", ""))]
    return [one for at, one in enumerate(files) if one and one not in files[:at] and os.path.isfile(one)]


def _encrypted(path: Path) -> bool:
    try:
        with open(path, "rb") as handle:
            return handle.read(14) == b"$ANSIBLE_VAULT"
    except OSError:
        return False


def _vaults_hold_their_own(layout: hosts.Layout, host: hosts.Host, password: str, keep: bool) -> str:
    """Why the vaults would send a host the wrong secret, or "": the shared vault holds the first host's token under
    the kind's shared name and never another host's, and a host's vault its own under the host name and never the
    shared one; and neither sets what the inventory defaults make from the run's host. defaults.yml picks the name by
    where the run's host was defined, so either in the other's file would defeat it. Opened in memory to read the names
    alone; kept as checked, by the files' sizes and times, until one changes - but by a run that writes nothing."""
    kind = host.kind
    shared = layout.checkout / hosts.SHARED_VAULT
    own = None if host.first else layout._path(host.vault_file)
    checked = layout.hosts_dir / ".checked.json"
    key = hosts.checked_digest([shared] if own is None else [shared, own])
    try:
        if key and json.loads(checked.read_text(encoding="utf-8")).get(host.name) == key:
            return ""
    except (OSError, ValueError, AttributeError):
        pass
    files = _password_files(password)
    shared_names = hosts.vault_names(shared, files)
    own_names = None if own is None else hosts.vault_names(own, files)
    for file, names in ((hosts.SHARED_VAULT, shared_names), (host.vault_file, own_names)):
        made = [name for name in kind.from_host if names is not None and name in names]
        if made:
            return (
                f"{file} sets {', '.join(made)}, which the inventory defaults make from the run's host - where its API "
                f"is, and the secret it is sent - and which a vault would set for "
                f"{'every host' if file == hosts.SHARED_VAULT else host.name} alike: take "
                f"{'it' if len(made) == 1 else 'them'} out with just vault"
                f"{'' if file == hosts.SHARED_VAULT else ' --host ' + host.name}"
            )
    if not host.first and shared_names is not None and kind.secret_host in shared_names:
        return (
            f"{hosts.SHARED_VAULT} sets {kind.secret_host}, which is a host's own and belongs in its vault: a host "
            f"whose vault lacked it would be sent this one. Move it with just vault, and just vault --host {host.name}"
        )
    if own_names is not None and kind.secret_shared in own_names:
        return (
            f"{host.vault_file} sets {kind.secret_shared}, the first host's name for its secret: {host.name}'s is "
            f"{kind.secret_host}. Rename it there with just vault --host {host.name}"
        )
    if own_names is not None and kind.secret_host not in own_names:
        return (
            f"{host.vault_file} does not set {kind.secret_host}, {host.name}'s secret: just init --host {host.name}, "
            f"or set it with just vault --host {host.name}"
        )
    # A vault no password here opens - a vault ID's, a client script's - is Ansible's to open: said, never kept as
    # checked, and the run goes on, the token rule still sending the host the secret of its own vault's name alone.
    unopened = [
        file
        for file, path, names in ((hosts.SHARED_VAULT, shared, shared_names), (host.vault_file, own, own_names))
        if path is not None and names is None and _encrypted(path)
    ]
    if unopened:
        print(
            f"warning: {' and '.join(unopened)} could not be opened here (a vault ID's password, or a client "
            "script's), so the names of the secrets in it are not checked before the run",
            file=sys.stderr,
        )
        return ""
    if keep and shared_names is not None and (own is None or own_names is not None) and key:
        try:
            kept = json.loads(checked.read_text(encoding="utf-8"))
            kept = kept if isinstance(kept, dict) else {}
        except (OSError, ValueError):
            kept = {}
        kept[host.name] = key
        temporary = checked.with_name(f".checked.{os.getpid()}")
        try:
            with open(os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as out:
                json.dump(kept, out)
            os.replace(temporary, checked)
        except OSError:
            pass
    return ""


def _what_a_run_reads(layout: hosts.Layout, host: hosts.Host, opts, keep: bool) -> str:
    """Why a run against a host, beside another, would read what is not its own, or "": a setting of one network the
    shared files set and a host in hosts/ does not, an internal made from the run's host that a settings file sets, a
    token under the other vault's name."""
    lines = layout.never_inherited(host)
    if lines:
        return (
            f"{hosts.SHARED_LOCAL} sets {', '.join(lines)}, which describe{'s' if len(lines) == 1 else ''} one "
            f"network or one host, and {host.local_file} does not: add {'it' if len(lines) == 1 else 'them'} "
            f"there for {host.name}, the value or the setting's default to say none"
        )
    for file, made in layout.made_from_host(host).items():
        return (
            f"{file} sets {', '.join(made)}, which the inventory defaults make from the run's host - where its API is, "
            "and the secret it is sent - and which a settings file would set for "
            f"{'every host' if file == hosts.SHARED_LOCAL else host.name} alike: take "
            f"{'it' if len(made) == 1 else 'them'} out. A host's address is ansible_host in its hosts.yml, and its "
            f"secret {host.kind.secret_shared} in the shared vault for the first host, {host.kind.secret_host} in its "
            "own for another"
        )
    return _vaults_hold_their_own(layout, host, opts.vault_pass, keep)


def every(opts, layout: hosts.Layout) -> int:
    """Every host, for just status to read each: its name, whether it is the current one, its sources and vaults, the
    other hosts its run is handed, and why it cannot be read, if anything does - said in its own block, never refusing
    the others'. --except leaves one out: a creating deploy asks the others for the names it would make. Writes
    nothing."""
    current = layout.resolve("")
    out = []
    for host in layout.every():
        if host.name == opts.except_:
            continue
        problem = host.problem or _what_a_run_reads(layout, host, opts, keep=False)
        if not problem:
            for vault in [hosts.SHARED_VAULT] if host.first else [hosts.SHARED_VAULT, host.vault_file]:
                path = layout._path(vault)
                if not path.is_file() or not _encrypted(path):
                    problem = (
                        f"{vault} is missing or not encrypted: just vault{'' if host.first else ' --host ' + host.name}"
                    )
        out.append(
            {
                "name": host.name,
                "current": current is not None and host.name == current.name,
                "sources": host.sources,
                "vault_files": [opts.vault_file] if host.first else [hosts.SHARED_VAULT, host.vault_file],
                "extra": {"claude_hosts_other": layout.others_of(host)},
                "problem": problem,
            }
        )
    print(json.dumps(out))
    return 0


def env(opts, layout: hosts.Layout) -> int:
    given = opts.host or opts.nested
    if opts.host and opts.nested and opts.host != opts.nested:
        return _refuse(f"--host {opts.host} in a run against {opts.nested}: one host per run")
    many = layout.many()
    routed = False
    names = [name for name in opts.names.split(",") if name]
    origins: dict[str, str] = {}
    if many and names:
        # A VM name is one host's, and its alias records which: a named VM is found where it is.
        origins = layout.origins(names)
        if given:
            elsewhere = {name: origin for name, origin in origins.items() if origin != given}
            if elsewhere:
                # A name two hosts each have, made before a name was one host's: the run reaches the VM of the name on
                # the host given, the alias stays the other's, and a run that would write it is refused
                # (tasks/vm_names.yml).
                said = ", ".join(f"{name} is {origin}'s" for name, origin in sorted(elsewhere.items()))
                print(
                    f"warning: {said}, as its SSH alias records, and this run is against {given}: it reaches the VM "
                    f"of the name on {given}. A VM name belongs to one host, so the alias stays where it is, and a run "
                    "here that would write it - just deploy, just code - is refused: give one of them another name",
                    file=sys.stderr,
                )
        else:
            on = sorted(set(origins.values()))
            if len(on) > 1:
                said = "; ".join(
                    f"{', '.join(sorted(n for n, o in origins.items() if o == origin))} on {origin}" for origin in on
                )
                return _refuse(
                    f"the VMs named are on {len(on)} hosts ({said}), as their SSH aliases record, and a run reaches "
                    "one host: run each host's on its own, with --host"
                )
            given, routed = (on[0], True) if on else ("", False)
    # One host, and none asked for: nothing to choose, and nothing read - the run is as it always was.
    host = layout.resolve(given, opts.lenient) if given or many or layout.current_name() else None
    overlay = host is not None and not host.first
    sources = ",".join(host.sources) if overlay else ""
    if many:
        first = layout.first()
        if first is not None and first.problem:
            return _refuse(f"the first host: {first.problem}")
        # A run's inventory is its host's, given as -i: an exported one would be the run's instead wherever none is
        # given - every run against the first host - and a host's sources a variable left exported could carry into
        # a later run against another, titled for it.
        if os.environ.get("ANSIBLE_INVENTORY"):
            return _refuse(
                f"ANSIBLE_INVENTORY is exported, and this checkout has more than one host: each run reads its host's "
                f"own inventory, {host.name}'s here, and nothing else. Unset it"
            )
    if overlay:
        if opts.vault_file != hosts.DEFAULT_VAULT or " ".join(opts.settings_files.split()) != hosts.DEFAULT_SETTINGS:
            return _refuse(
                f"VAULT_FILE and SETTINGS_FILES name the first host's files, and this run's host is {host.name}: give "
                "them only for a run against the first host"
            )
    if many and not opts.lenient:
        why = _what_a_run_reads(layout, host, opts, keep=not opts.read_only)
        if why:
            return _refuse(why)
    others = layout.others_of(host) if many else []
    for other in others:
        if other["address"] and not ADDRESS.fullmatch(other["address"]):
            return _refuse(
                f"{other['name']}'s ansible_host is no address or host name, one word: fix it in its hosts.yml"
            )
    if overlay:
        settings = [hosts.SHARED_LOCAL, host.hosts_file, host.local_file]
        vaults = [hosts.SHARED_VAULT, host.vault_file]
    else:
        settings, vaults = opts.settings_files.split(), [opts.vault_file]
    if routed:
        # Said where it is not the host the person would take it for: the run's title and a deletion's question name it
        # too.
        try:
            current = layout.resolve("")
        except hosts.Refused:
            current = None
        if current is not None and current.name != host.name:
            placed = sorted(origins)
            print(
                f"{', '.join(placed)} {'is' if len(placed) == 1 else 'are'} {host.name}'s, as "
                f"{'its' if len(placed) == 1 else 'their'} SSH alias records: this run is against {host.name}, not the "
                f"current host, {current.name}.",
                file=sys.stderr,
            )
    values = {
        "host": host.name if host else "",
        "hosts_many": "1" if many else "",
        "settings_files": " ".join(settings),
        "vault_files": " ".join(vaults),
        "host_sources": sources,
        "host_extra": json.dumps({"claude_hosts_other": others}) if many else "",
        # The VMs named that no alias places on one of the hosts: a creating deploy asks the other hosts for these.
        "host_unplaced": ",".join(name for name in names if name not in origins) if many else "",
    }
    for name, value in values.items():
        print(f"{name}={shlex.quote(value)}")
    return 0


def _first_host_init(kind: hosts.Kind) -> int:
    """The first host's: the shared files, which the recipe copies from their examples, its secret under the shared
    name. Nothing is read for it."""
    print(f"init_host_json={shlex.quote(json.dumps({'init_host': {'name': '', 'secret': kind.secret_shared}}))}")
    print("host_sources=''")
    return 0


def init(opts, layout: hosts.Layout) -> int:
    name = opts.name
    # One kind of host so far: the first host's, and every new one's.
    (kind,) = hosts.KINDS.values()
    # The current host's, as every command's: the first's until another is chosen - read only where hosts/current
    # names one, so that a bare just init of one host reads nothing, as before there were hosts.
    current = "" if name else layout.current_name()
    if not name and not current:
        return _first_host_init(kind)
    first = layout.first()
    folders = layout.folders()
    if not name:
        if first is not None and current == first.name:
            return _first_host_init(kind)
        if current not in folders:
            return _refuse(
                f"{layout.hosts_rel}/current names {current}, which is no host of this checkout's: just host <name> "
                "chooses another"
            )
        name = current
    elif first is not None and name == first.name:
        if not folders and not opts.address:
            return _refuse(
                f"--host names a host from 2.4, and with no other host here, {name} may be 2.3's address of the "
                f"Proxmox host: give that as --address {name}. {name} is the name of this checkout's one host, which "
                "just init alone sets up"
            )
        return _first_host_init(kind)
    if opts.shared:
        # Every host's, in the shared files, which the first host's init writes.
        return _refuse(
            f"the GitHub account and the VPN are every host's, in the shared files, and this init is {name}'s: give "
            f"--github-user and --tailscale to just init{' --host ' + first.name if first is not None else ''}"
        )
    if first is None:
        return _refuse(
            f"{hosts.SHARED_HOSTS} names no host yet: just init sets up the first one there - given as --address "
            f"{name}, if {name} is its address - then just init --host <name> another"
        )
    if name in hosts.RESERVED:
        return _refuse(f"{name} is no host's name: never {', '.join(sorted(hosts.RESERVED))}")
    if name not in folders and not opts.address:
        if not folders:
            return _refuse(
                f"--host names a host from 2.4, and {name} is none of this checkout's ({first.name}). If {name} is "
                f"the Proxmox host's address, give it as --address {name}; to set up a second host named {name}, "
                f"give its address too: just init --host {name} --address <address>"
            )
        if not opts.asking:
            return _refuse(
                f"{name} is no host of this checkout's yet, and there is no terminal to ask its address at: "
                f"just init --host {name} --address <address>"
            )
    if first.problem:
        return _refuse(f"the first host: {first.problem}")
    exported = next((variable for variable in SECRET_VARIABLES if os.environ.get(variable)), "")
    if exported and not opts.secret_file:
        # The first deploy's guide exports it for the first host: left in the shell, it would be written to this
        # host's vault and sent to its API as this host's.
        return _refuse(
            f"{exported} is exported, and this init is {name}'s, whose token is its own: unset it, and give {name}'s "
            f"secret in a file only you can read, just init --host {name} --token-secret-file <file>"
        )
    host = hosts.Host(name=name, folder=f"{layout.hosts_rel}/{name}", first=False, kind=kind)
    if (
        _encrypted(layout.checkout / hosts.SHARED_VAULT)
        and not _password_files(opts.vault_pass)
        and not _encrypted(layout._path(host.vault_file))
    ):
        # just init would make .vault_pass anew for the host's vault, which then opens neither the shared one nor any
        # run that reads both.
        return _refuse(
            f"{hosts.SHARED_VAULT} is encrypted, and there is no {Path(opts.vault_pass).name or '.vault_pass'} or "
            f"ANSIBLE_VAULT_PASSWORD_FILE to open it with: {name}'s vault is encrypted with the same password, so put "
            "it in a file only you can read, named by ANSIBLE_VAULT_PASSWORD_FILE or as .vault_pass, first"
        )
    made = []
    for file in (host.hosts_file, host.local_file, host.vault_file):
        path = layout._path(file)
        if path.exists():
            continue
        relative = path.relative_to(layout._path(host.folder))
        text = (TEMPLATES / f"{relative}.example").read_text(encoding="utf-8")
        text = text.replace("\n        pve:\n", f"\n        {name}:\n").replace("pve-default", f"{name}-default")
        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        # Readable by you alone, as the shared files just init copies are: the vault is plaintext until just init
        # encrypts it.
        with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w", encoding="utf-8") as out:
            out.write(text)
        made.append(file)
    said = {
        "init_hosts_file": str(layout._path(host.hosts_file)),
        "init_local_file": str(layout._path(host.local_file)),
        "init_vault_file": str(layout._path(host.vault_file)),
        "init_host": {
            "name": name,
            "secret": kind.secret_host,
            "always": list(kind.always),
            "default_vm": f"{name}-default",
            # Whether it is the current host already, as a bare just init's is: then no switch is offered.
            "current": layout.current_name() == name,
            "hosts_said": host.hosts_file,
            "local_said": host.local_file,
            "vault_said": host.vault_file,
        },
    }
    print(f"init_host_json={shlex.quote(json.dumps(said))}")
    print(f"host_sources={shlex.quote(','.join(host.sources))}")
    print(f"init_settings_files={shlex.quote(' '.join([hosts.SHARED_LOCAL, host.hosts_file, host.local_file]))}")
    print(f"init_vault={shlex.quote(host.vault_file)}")
    print(f"init_made={shlex.quote(' '.join(made))}")
    return 0


def current(opts, layout: hosts.Layout) -> int:
    """The current host's name - the one hosts/current names, else the first's - "" with no host at all: what just init
    asks before it offers a switch."""
    host = layout.resolve("")
    print(host.name if host else "")
    return 0


def _defaults(checkout: Path) -> dict:
    """The inventory defaults, as YAML reads them: a setting a host's files leave unset shows its default."""
    try:
        found = hosts._yaml(checkout / "inventory" / "group_vars" / "all" / "defaults.yml")
    except hosts.Refused:
        return {}
    return found if isinstance(found, dict) else {}


def listing(opts, layout: hosts.Layout) -> int:
    try:
        every = layout.every()
        current = layout.resolve("") if every else None
    except hosts.Refused as refused:
        try:
            every = layout.every()
        except hosts.Refused:
            every = []
        current = None
        said = str(refused)
    else:
        said = ""
    defaults = _defaults(layout.checkout)
    rows = []
    for host in every:
        shown = host.shown()
        for _, setting in host.kind.shown if host.kind else ():
            if shown["settings"].get(setting) in (None, ""):
                shown["settings"][setting] = defaults.get(setting) if host.first else None
        rows.append(
            {
                **shown,
                "host_kind": host.kind.key if host.kind else None,
                "first": host.first,
                "current": current is not None and host.name == current.name,
                "problem": host.problem,
            }
        )
    if opts.json:
        # A document a release only adds keys to (CONTRIBUTING.md, Releasing): format_version and kind first, as
        # wire.to_wire puts them, and no other key named kind or current, so each means one thing.
        document = {"format_version": wire.FORMAT_VERSION, "kind": "host_list"}
        # "" for none, as a row's problem is: null only where no value can be had - no current host.
        document |= {"current_host": current.name if current else None, "hosts": rows, "problem": said or ""}
        print(json.dumps(document))
        return 0
    if not rows:
        print(f"{said}." if said else "No host yet: just init sets up the first, in inventory/hosts.yml.")
        return 0
    headings = []
    for kind in hosts.KINDS.values():
        headings += [heading for heading in kind.shown if heading not in headings]
    table = [["  HOST", "ADDRESS", *(heading for heading, _ in headings), "SETTINGS", ""]]
    for row in rows:
        cells = [
            str(row["settings"].get(setting) if row["settings"].get(setting) is not None else "-")
            for _, setting in headings
        ]
        note = "the current host" if row["current"] else row["problem"]
        name = f"{'▸' if row['current'] else ' '} {row['name']}"
        table.append([name, row["address"] or "-", *cells, f"{row['folder']}/", note])
    widths = [max(len(line[at]) for line in table) for at in range(len(table[0]) - 1)]
    for line in table:
        columns = "  ".join(cell.ljust(width) for cell, width in zip(line, widths, strict=False))
        print(f"{columns}  {line[-1]}" if line[-1] else columns.rstrip())
    print()
    if said:
        print(f"{said}.")
    if len(rows) > 1:
        print("just host <name> switches; --host <name> on a command reaches another host once.")
    else:
        print("One host: just init --host <name> --address <address> sets up another.")
    return 0


def switch(opts, layout: hosts.Layout) -> int:
    host = layout.switch(opts.name)
    print(f"{host.name} is the current host: every command runs against it, and --host <name> reaches another once.")
    return 0


def remove(opts, layout: hosts.Layout) -> int:
    name = opts.name
    first = layout.first()
    if first is not None and name == first.name:
        return _refuse(
            f"{name} is the first host, whose settings are {hosts.SHARED}/'s: just host --remove removes "
            "only a host in hosts/"
        )
    if name not in layout.folders():
        return _refuse(f"{layout.hosts_rel}/{name} is no host's folder: just host lists them")
    if name == layout.current_name():
        return _refuse(f"{name} is the current host: switch to another first, just host <name>")
    shutil.rmtree(layout.hosts_dir / name)
    print(
        f"Removed {layout.hosts_rel}/{name}/, this checkout's settings and token for {name}. Its VMs are still there "
        "on it, and their SSH aliases here: a fleet-wide just deploy --only ssh-config prunes none of them."
    )
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="tools/host")
    parser.add_argument("action", choices=["env", "list", "switch", "remove", "init", "current", "every"])
    parser.add_argument("name", nargs="?", default="")
    parser.add_argument("--checkout", required=True)
    parser.add_argument("--hosts-dir", required=True)
    parser.add_argument("--host", default="")
    parser.add_argument("--nested", default="")
    parser.add_argument("--names", default="")
    parser.add_argument("--vault-file", default=hosts.DEFAULT_VAULT)
    parser.add_argument("--settings-files", default=hosts.DEFAULT_SETTINGS)
    parser.add_argument("--vault-pass", default="")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--lenient", action="store_true")
    parser.add_argument("--read-only", action="store_true")
    parser.add_argument("--asking", action="store_true")
    parser.add_argument("--address", default="")
    # just init's: a value given for the shared files (the GitHub account, the VPN), and the token secret's file.
    parser.add_argument("--shared", action="store_true")
    parser.add_argument("--secret-file", action="store_true")
    parser.add_argument("--except", dest="except_", default="")
    opts = parser.parse_args(argv)
    for value in (opts.host, opts.nested, opts.name):
        if value and not hosts.NAME.fullmatch(value):
            return _refuse(f"a host's name is lowercase letters, digits and -, at most 31 (got: [{value}])")
    checkout = Path(opts.checkout)
    hosts_dir = Path(opts.hosts_dir)
    layout = hosts.Layout(checkout, hosts_dir if hosts_dir.is_absolute() else checkout / hosts_dir)
    actions = {"env": env, "list": listing, "switch": switch, "remove": remove, "init": init, "current": current}
    action = {**actions, "every": every}[opts.action]
    if opts.action in ("switch", "remove") and not opts.name:
        return _refuse(f"just host {'--remove ' if opts.action == 'remove' else ''}takes the host's name")
    try:
        return action(opts, layout)
    except hosts.Refused as refused:
        # Whatever the files say that keeps the hosts from being read - a file that is not YAML, hosts/current naming
        # no host - is said as the recipe's error, never a traceback.
        return _refuse(str(refused))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
