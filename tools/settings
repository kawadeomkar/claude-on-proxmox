class Refused(Exception):
    """A reason to print nothing and exit 1."""


class LookupRefused(Exception):
    """A lookup outside SAFE_LOOKUPS, refused where Ansible loads it."""


def _hold_lookups() -> None:
    real = plugin_loader.lookup_loader.get

    def get(name, *args, **kwargs):
        found = plugin_loader.lookup_loader.find_plugin_with_context(name)
        fqcn = found.resolved_fqcn if found.resolved else name
        if fqcn not in SAFE_LOOKUPS:
            raise LookupRefused(fqcn)
        return real(name, *args, **kwargs)

    plugin_loader.lookup_loader.get = get


def _cause(error: BaseException | None, kind: type) -> BaseException | None:
    seen = set()
    while error is not None and id(error) not in seen:
        if isinstance(error, kind):
            return error
        seen.add(id(error))
        error = error.__cause__ or error.__context__
    return None


class _AnyName(dict):
    """Every filter and test name exists: an expression's variables are read without Ansible's plugins."""

    def __contains__(self, key):
        return True

    def __getitem__(self, key):
        return lambda *args, **kwargs: None

    def get(self, key, default=None):
        return self[key]


_JINJA = Environment()
_JINJA.filters = _AnyName()
_JINJA.tests = _AnyName()


def names_in(expression) -> set[str]:
    """The variables an expression reads; none for a value that is no template."""
    if not isinstance(expression, str) or ("{{" not in expression and "{%" not in expression):
        return set()
    return meta.find_undeclared_variables(_JINJA.parse(expression)) - {"lookup", "query", "q"}


def _leaves(value):
    if isinstance(value, dict):
        for item in value.values():
            yield from _leaves(item)
    elif isinstance(value, list):
        for item in value:
            yield from _leaves(item)
    else:
        yield value


class _Tagged(yaml.SafeLoader):
    """YAML with every tag - !vault, !unsafe - kept as its tag and text, never decrypted: local.yml before and after
    a write compared key by key, an inline secret among them compared as its ciphertext."""


_Tagged.add_multi_constructor(
    "!", lambda loader, suffix, node: {"tag": suffix, "text": str(getattr(node, "value", ""))}
)


def tagged(source: str):
    return yaml.load(source, Loader=_Tagged)  # noqa: S506 - a SafeLoader, that keeps tags as text


# ------------------------------------------------------------------------------------- the playbooks, read ---
def _plays(path: Path) -> list[dict]:
    return [item for item in yaml.safe_load(path.read_text()) or [] if isinstance(item, dict)]


def _role_runs(tasks):
    """(role, vars, tasks_from) of each import_role and include_role in tasks, blocks included."""
    for task in tasks or []:
        if not isinstance(task, dict):
            continue
        for key in ("block", "rescue", "always"):
            yield from _role_runs(task.get(key))
        for module in ("ansible.builtin.import_role", "ansible.builtin.include_role"):
            if module in task:
                given = task[module] or {}
                yield given.get("name"), task.get("vars") or {}, given.get("tasks_from")


def _runs(play: dict):
    runs = [
        (
            (role if isinstance(role, str) else role.get("role") or role.get("name")),
            (role.get("vars") if isinstance(role, dict) else None) or {},
            None,
        )
        for role in play.get("roles") or []
    ]
    for section in ("pre_tasks", "tasks", "post_tasks", "handlers"):
        runs += list(_role_runs(play.get(section)))
    return runs


def _added(tasks):
    """The arguments of each add_host in tasks, blocks included."""
    for task in tasks or []:
        if isinstance(task, dict):
            for key in ("block", "rescue", "always"):
                yield from _added(task.get(key))
            if "ansible.builtin.add_host" in task:
                yield task["ansible.builtin.add_host"] or {}


def playbooks() -> list[Path]:
    return [REPO / "deploy.yml", *sorted((REPO / "playbooks").glob("*.yml"))]


def where_roles_run() -> dict[str, str]:
    """Each role's group: the hosts of the play that runs its main entry point and passes it nothing - provision.yml's
    claude_vm_pending for proxmox_vm, not destroy.yml's, which passes proxmox_vm_state: absent."""
    found: dict[str, str] = {}
    for path in playbooks():
        for play in _plays(path):
            for role, given, tasks_from in _runs(play):
                if role and not given and not tasks_from and isinstance(play.get("hosts"), str):
                    found.setdefault(role, play["hosts"])
    return found


def _justfile() -> dict[str, str]:
    """Each recipe's script, the assignments it names written out."""
    source = (REPO / "justfile").read_text()
    assignments = dict(re.findall(r"(?m)^([a-z_]+) := (.*)$", source))
    bodies: dict[str, str] = {}
    recipe = None
    for line in source.splitlines():
        head = re.match(r"^([a-z][a-z_]*)(?: [^:]*)?:\s*$", line)
        if head:
            recipe = head.group(1)
            bodies[recipe] = ""
        elif recipe and line.startswith("    "):
            bodies[recipe] += re.sub(r"\{\{ (\w+) \}\}", lambda m: assignments.get(m.group(1), m.group(0)), line) + "\n"
        elif line and not line.startswith(" "):
            recipe = None
    return bodies


def _how(expression) -> str:
    """What a run sets a variable from, as the report says it."""
    if isinstance(expression, str) and "{{" in expression:
        same = re.fullmatch(r"\{\{\s*(\w+)\s*\}\}", expression.strip())
        return f"from {same.group(1)}" if same else "per run"
    return f"to {json.dumps(expression)}"


def run_sets() -> dict[str, list[str]]:
    """The variables a run sets above the inventory, each with what sets it: "just deploy sets it from deploy_sign_in".

    A playbook no other imports is the run of the recipe of the same name; the vars it passes - on an import, a
    play, a role, an add_host - are read through every import. The justfile's -e objects, recipe by recipe, too.
    """
    bodies = _justfile()
    books = playbooks()
    imported = {
        (path.parent / item["ansible.builtin.import_playbook"]).resolve()
        for path in books
        for item in _plays(path)
        if item.get("ansible.builtin.import_playbook")
    }
    found: dict[str, list[str]] = {}

    def record(name, said):
        if said not in found.setdefault(name, []):
            found[name].append(said)

    def walk(path: Path, recipe: str, seen: set) -> None:
        if path in seen or not path.is_file():
            return
        seen.add(path)
        for item in _plays(path):
            given = dict(item.get("vars") or {})
            for _role, role_vars, _tasks_from in _runs(item):
                given.update(role_vars)
            for section in ("pre_tasks", "tasks", "post_tasks"):
                for added in _added(item.get(section)):
                    given.update({k: v for k, v in added.items() if k not in ("name", "groups", "group")})
            for name, expression in given.items():
                record(name, f"just {recipe} sets it {_how(expression)}")
            if item.get("ansible.builtin.import_playbook"):
                walk((path.parent / item["ansible.builtin.import_playbook"]).resolve(), recipe, seen)

    for path in books:
        if path.resolve() not in imported and path.stem in bodies:
            walk(path.resolve(), path.stem, set())
    for recipe, body in bodies.items():
        for line in body.splitlines():
            if " -e " in line:
                for name, value in re.findall(r'\\?"([a-z_]+)\\?"\s*:\s*([a-z0-9]+)', line):
                    if name not in NOT_SETTINGS:
                        record(name, f"just {recipe} may pass {value}")
    return found


# --------------------------------------------------------------------------------------------- the report ---
# What Ansible lets a process set up once: its plugin loader, the lookups held, and the vault's secrets, which
# CLI.setup_vault_secrets makes the process's own (VaultSecretsContext). A second Settings - --value reads the files
# again after its write - reuses them.
_ONCE: dict = {}


def _set_up(loader: DataLoader, password: str) -> None:
    if "plugins" not in _ONCE:
        _hold_lookups()
        init_plugin_loader([])
        _ONCE["plugins"] = True
    if password:
        if "secrets" not in _ONCE:
            _ONCE["secrets"] = CLI.setup_vault_secrets(loader, vault_ids=[], vault_password_files=[password])
        loader.set_vault_secrets(_ONCE["secrets"])


class Settings:
    """Every value, as Ansible gives it to the play that runs each role, with where it was set."""

    def __init__(self, inventory: Path, password: str):
        self.specs = docs.specs()
        self.defaults, self.feeds = docs.wiring()
        self.loader = DataLoader()
        self.vault_file = inventory / "group_vars" / "all" / "vault.yml"
        encrypted = self.vault_file.is_file() and self.vault_file.read_bytes().startswith(b"$ANSIBLE_VAULT")
        _set_up(self.loader, password)
        if not password and encrypted:
            raise Refused(
                "vault.yml is encrypted, and there is no .vault_pass or ANSIBLE_VAULT_PASSWORD_FILE to open it with"
            )
        try:
            self.inventory = InventoryManager(loader=self.loader, sources=[str(inventory)])
            self.vault = self._read(self.vault_file)
        except AnsibleError as error:
            if "ecrypt" in str(error):
                raise Refused(f"vault.yml could not be opened with {password}") from error
            raise
        self.local_file = inventory / "group_vars" / "all" / "local.yml"
        self.local = self._read(self.local_file)
        self.project = self._read(inventory / "group_vars" / "all" / "defaults.yml")
        self.host_vars = inventory / "host_vars"
        self.variables = VariableManager(loader=self.loader, inventory=self.inventory)
        self.example_vault = yaml.safe_load((REPO / VAULT).with_suffix(".yml.example").read_text()) or {}
        self.example_settings = {
            name
            for _title, groups in docs.parse_example(REPO / LOCAL.replace(".yml", ".yml.example"), secret=False)
            for _prose, found in groups
            for name, _example in found
        }
        self.where = where_roles_run()
        self.run_sets = run_sets()
        self.contexts: dict[str, dict] = {}
        # Lock 5's list: what the vault holds but the identifiers, the GitHub username and an OAuth client's ID, which
        # are masked in their own rows and never looked for elsewhere - a username that is a common word would
        # otherwise refuse every report. Inline !vault values and no_log values join it as they are templated.
        self.hunted = {
            str(value)
            for name, value in self.vault.items()
            if isinstance(value, str)
            and len(value.strip()) >= 4
            and not self.identifier(name)
            and not self.placeholder(name, value)
        }

    def _read(self, path: Path) -> dict:
        # cache="none": the loader caches a file without its trust as a template, and the inventory, reading the
        # same file after, would get that copy and template none of its values.
        return (self.loader.load_from_file(str(path), cache="none") or {}) if path.is_file() else {}

    def no_log(self, name: str) -> bool:
        return any(options.get(name, {}).get("no_log") for options in self.specs.values())

    def identifier(self, vault_name: str) -> bool:
        fed = docs.set_by(vault_name, self.feeds, self.specs)
        return bool(fed) and not any(self.no_log(name) for name in fed)

    def placeholder(self, name: str, value) -> bool:
        """Still the example's value, as just init decides it - never by a pattern."""
        example = self.example_vault.get(name)
        return example not in ("", None) and value == example

    # ------------------------------------------------------------------------------------------- --value ---
    def fed_by(self, name: str) -> str | None:
        """The setting of the examples a role variable is set through, following settings that set settings:
        claude_remote_control for claude_code_remote_control, login_desktop for tailscale_login_desktop."""
        documented = self.example_settings | set(self.example_vault)
        for setting, fed in self.feeds.items():
            if name in fed:
                return setting if setting in documented else self.fed_by(setting)
        return None

    def role_for(self, name: str) -> str | None:
        """The role a name is a variable of, or the first role whose variables it sets."""
        return docs.role_of(name, self.specs) or next(
            (docs.role_of(var, self.specs) for var in docs.set_by(name, self.feeds, self.specs)), None
        )

    def settable(self, name: str) -> tuple[str | None, str, str]:
        """What --value writes for a name, or why not: (the name written, "", ""), or (None, why, where it changes).

        The read view's "change" comes from here too, so it never names a command this refuses."""
        if name == "ansible_host":
            return None, "the Proxmox host's address is in inventory/hosts.yml", "inventory/hosts.yml"
        if name in self.example_vault or name.startswith("vault_"):
            return None, f"{name} is held in vault.yml", "just vault"
        role = docs.role_of(name, self.specs)
        target = (self.fed_by(name) or name) if role else name
        if target in self.example_vault:
            return None, f"{name} comes from {target}, which vault.yml holds", "just vault"
        if not role and target not in self.example_settings:
            # A value of defaults.yml that is in neither the examples nor a role's argument_specs is internal
            # (docs/reference/settings.md).
            return None, f"{name} is no setting: it is internal to the project", ""
        fed = {name, target, *docs.set_by(target, self.feeds, self.specs)}
        if any(self.no_log(each) for each in fed):
            return None, f"{name} is a secret", "just vault"
        if VaultHelper.get_ciphertext(self.local.get(target), with_tags=False) is not None:
            return None, f"local.yml holds {target} encrypted (!vault)", LOCAL
        context = self.context(self.role_for(target) or "common")
        if self.walk(context, name)["per_vm"]:
            return None, f"{name} is made from each VM's own name: one setting would give every VM the same", ""
        if name in self.run_sets and target not in self.example_settings:
            return None, f"{name} is set by a run itself ({'; '.join(self.run_sets[name])})", ""
        if self.spec_for(target, name).get("type") == "raw":
            return None, f"{name} takes any value, so --value cannot hold it to a type", LOCAL
        return target, "", ""

    def spec_for(self, target: str, name: str) -> dict:
        """The type a setting takes: its own argument_specs, the first role variable's it feeds, or its default's."""
        for each in (name, target, *docs.set_by(target, self.feeds, self.specs)):
            role = docs.role_of(each, self.specs)
            if role:
                return {
                    key: value
                    for key, value in self.specs[role][each].items()
                    if key in ("type", "elements", "choices")
                }
        default = self.defaults.get(target)
        for kind, python in (("bool", bool), ("int", int), ("list", list), ("dict", dict)):
            if isinstance(default, python):
                return {"type": kind} | ({"elements": "str"} if kind == "list" else {})
        return {"type": "str"}

    def coerce(self, target: str, name: str, raw: str):
        """raw, the text after --value, as the value the setting takes: refused unless Ansible's own validator, as
        the role checks its arguments, takes it."""
        if CONTROL.search(raw):
            raise Refused("a value is one line of text, without a control character")
        if TEMPLATE.search(raw):
            raise Refused(
                "--value takes a value, never an expression ({{ }}, {% %} or {# #}), which Ansible would template: "
                f"to write one, edit {LOCAL}"
            )
        spec = self.spec_for(target, name)
        kind = spec.get("type", "str")
        given = raw
        if kind in ("list", "dict") and raw.lstrip()[:1] in ("[", "{"):
            try:
                given = yaml.safe_load(raw)
            except yaml.YAMLError as error:
                raise Refused(f"{target} takes {TAKES[kind]}: {raw} is not YAML") from error
        result = ArgumentSpecValidator({target: spec}).validate({target: given})
        if result.error_messages:
            takes = f"one of {', '.join(map(str, spec['choices']))}" if "choices" in spec else TAKES.get(kind, kind)
            raise Refused(f"{target} takes {takes}, not {text.one_line(raw, 80)}")
        if kind in ("str", "path"):
            return raw  # as typed: a path keeps its ~, for every machine that reads it
        return json.loads(json.dumps(result.validated_parameters[target]))

    def write(self, name: str, raw: str) -> dict:
        """Write one setting into local.yml, or refuse with nothing written."""
        target, why, where = self.settable(name)
        if target is None:
            said = (
                f"{why}: change it with {where}"
                if where.startswith("just")
                else (
                    f"{why}: change it there"
                    if where and where in why
                    else f"{why}: change it in {where}"
                    if where
                    else why
                )
            )
            # A secret typed on the command line is in the shell's history now, whatever happens here.
            if where == "just vault":
                said += ". The value given was not used or printed, but your shell's history keeps it"
            raise Refused(said)
        value = self.coerce(target, name, raw)
        if any(secret in raw or secret in json.dumps(value) for secret in self.hunted):
            # A secret of the vault's would be in local.yml in the clear, and printed by every report after.
            raise Refused(
                f"that value is a secret the vault holds, so {target} would hold it in the clear: not written"
            )
        if not self.local_file.is_file():
            raise Refused(f"{LOCAL} missing. Run: just init")
        source = self.local_file.read_text()
        try:
            before = tagged(source) or {}
        except yaml.YAMLError as error:
            raise Refused(f"{LOCAL} is not YAML that reads: nothing was written") from error
        if not isinstance(before, dict):
            raise Refused(f"{LOCAL} is not a mapping of settings: nothing was written")
        lines = source.splitlines(keepends=True)
        setting = re.compile(rf"^{re.escape(target)}\s*:")
        found = [index for index, line in enumerate(lines) if setting.match(line)]
        if len(found) > 1:
            raise Refused(f"{LOCAL} sets {target} on {len(found)} lines, and the last wins: keep one, by hand")
        if found and before.get(target) == value:
            return {"asked": name, "wrote": None, "name": target, "value": value, "line": found[0] + 1}
        if found:
            start = end = found[0]
            end += 1
            while end < len(lines) and re.match(r"^([ \t]+\S|-([ \t]|$))", lines[end]):
                end += 1  # its value's further lines
            how = "in place of the line that set it"
        else:
            example = re.compile(rf"^#\s?{re.escape(target)}:")
            start = next((index for index, line in enumerate(lines) if example.match(line)), len(lines))
            end = start + 1 if start < len(lines) else start
            while end < len(lines) and re.match(r"^#\s{3,}\S", lines[end]):
                end += 1  # its example value's further lines, as tools/docs.py reads the example
            how = "in place of its example's line" if start < len(lines) else "at its end"
            if start == len(lines) and lines and not lines[-1].endswith("\n"):
                lines[-1] += "\n"
        written = f"{target}: {json.dumps(value, ensure_ascii=False)}\n"
        result = "".join([*lines[:start], written, *lines[end:]])
        try:
            after = tagged(result)
        except yaml.YAMLError:
            after = None  # an alias left without its anchor, and the like: refused below
        others = {key: item for key, item in before.items() if key != target}
        if (
            not isinstance(after, dict)
            or after.get(target) != value
            or {key: item for key, item in after.items() if key != target} != others
        ):
            raise Refused(f"{LOCAL} is not laid out so {target} can be written safely: nothing was written")
        mode = stat.S_IMODE(self.local_file.stat().st_mode)
        handle, scratch = tempfile.mkstemp(dir=self.local_file.parent, prefix=".local.yml.", suffix=".tmp")
        try:
            with os.fdopen(handle, "w") as stream:
                stream.write(result)
                stream.flush()
                os.fsync(stream.fileno())
            os.chmod(scratch, mode)
            os.replace(scratch, self.local_file)
        except BaseException:
            Path(scratch).unlink(missing_ok=True)
            raise
        return {
            "asked": name,
            "wrote": written.rstrip("\n"),
            "name": target,
            "value": value,
            "line": start + 1,
            "how": how,
        }

    def applies(self, target: str) -> list[str]:
        """What puts a setting to use, by the roles of the variables it sets."""
        roles = {docs.role_of(var, self.specs) for var in {target, *docs.set_by(target, self.feeds, self.specs)}}
        roles.discard(None)
        said = []
        configured = sorted(roles & set(CONFIGURED))
        if configured:
            tags = ",".join(configured)
            said.append(f"just deploy --only configure --tags {tags} applies it to every VM")
        if "proxmox_vm" in roles:
            said.append(
                "a VM gets it when it is created: one that exists keeps what it was made with (just status "
                "shows one that differs)"
            )
        if "proxmox_template" in roles:
            said.append("the template gets it when it is built: one that exists stays as it is")
        return said or ["the next run uses it"]

    def context(self, role: str) -> dict:
        """The role's variables as the play that runs it sees them: on its group's first host, or a placeholder."""
        if role in self.contexts:
            return self.contexts[role]
        group = self.where.get(role, "claude_vms")
        hosts = self.inventory.get_hosts(group)
        if hosts:
            host, placeholder = hosts[0], False
        else:
            if group not in self.inventory.groups:
                self.inventory.add_group(group)
            self.inventory.add_host(f"settings-{group}", group=group)
            host, placeholder = self.inventory.get_host(f"settings-{group}"), True
        play = Play.load(
            {"name": "settings", "hosts": host.name, "gather_facts": False, "roles": [role]},
            variable_manager=self.variables,
            loader=self.loader,
        )
        values = self.variables.get_vars(play=play, host=host)
        inventory_layer = {name: value for name, value in host.vars.items() if not name.startswith("ansible_")}
        for each in host.get_groups():
            for name, value in each.get_vars().items():
                inventory_layer.setdefault(name, value)
        self.contexts[role] = {
            "group": group,
            "placeholder": placeholder,
            "values": values,
            "templar": Templar(loader=self.loader, variables=values),
            "layers": [  # highest first, each named for the file a person edits
                ("internal", self._read(REPO / "roles" / role / "vars" / "main.yml")),
                ("hosts.yml", inventory_layer),
                ("vault.yml", self.vault),
                ("local.yml", self.local),
                ("default", self.project),
                ("default", self._read(REPO / "roles" / role / "defaults" / "main.yml")),
            ],
        }
        return self.contexts[role]

    @staticmethod
    def layer(context: dict, name: str):
        return next(((label, data[name]) for label, data in context["layers"] if name in data), ("unset", None))

    def walk(self, context: dict, name: str, depth: int = 0) -> dict:
        """What a value is made of, followed through the wiring: the person's own settings it reads, and whether it
        reads a secret (lock 4), the VM's name or the VM's facts."""
        found = {"user": [], "secret": False, "per_vm": False, "facts": False}
        if depth >= 6:
            return found
        for ref in sorted(names_in(self.layer(context, name)[1])):
            if ref in ("inventory_hostname", "inventory_hostname_short"):
                found["per_vm"] = True
                continue
            if ref == "ansible_facts":
                found["facts"] = True
                continue
            if ref in self.vault or ref in self.example_vault or self.no_log(ref):
                found["secret"] = True
            where, raw = self.layer(context, ref)
            if where in USERS:
                real = not (where == "vault.yml" and (raw in ("", None) or self.placeholder(ref, raw)))
                found["user"].append((ref, where, real))
            deeper = self.walk(context, ref, depth + 1)
            found["user"] += deeper["user"]
            for key in ("secret", "per_vm", "facts"):
                found[key] |= deeper[key]
        return found

    def row(self, role: str, name: str, spec: dict) -> dict:
        context = self.context(role)
        where, raw = self.layer(context, name)
        made_of = self.walk(context, name)
        via = list(dict.fromkeys((ref, file) for ref, file, _real in made_of["user"]))
        row = {
            "name": name,
            "role": role,
            "kind": "value",
            "value": None,
            "set_in": where if where in USERS else (via[0][1] if via else "default"),
            "via": [{"name": ref, "file": file} for ref, file in via],
            "evaluated_as": context["group"],
        }
        if name in self.run_sets:
            row["set_by_run"] = self.run_sets[name]
        row["changed"] = (
            where in USERS and not (where == "vault.yml" and (raw in ("", None) or self.placeholder(name, raw)))
        ) or any(real for _ref, _file, real in made_of["user"])
        secret = where == "vault.yml" or bool(spec.get("no_log")) or made_of["secret"]  # locks 1, 3, 4
        if made_of["facts"]:
            row["kind"] = "on_the_vm"
        elif made_of["per_vm"] and context["placeholder"]:
            row["kind"] = "per_vm"
        else:
            try:
                value = context["templar"].template(context["values"][name])
            except Exception as error:  # noqa: BLE001 - whatever a template raises, the value is not known here
                refused = _cause(error, LookupRefused)
                row["kind"] = "at_run_start" if refused else "on_the_vm"
                if refused:
                    row["lookup"] = str(refused)
            else:
                vaulted = [
                    item for item in _leaves(value) if VaultHelper.get_ciphertext(item, with_tags=False) is not None
                ]
                if vaulted:  # lock 2: Ansible's own mark on what it decrypted, an inline !vault included
                    secret = True
                    self.hunted.update(str(item) for item in vaulted if len(str(item)) >= 4)
                plain = json.loads(json.dumps(value))  # Ansible's tagged types, made plain
                if secret:
                    vault_name = via[0][0] if via and via[0][1] == "vault.yml" else name
                    row["kind"] = "secret"
                    row["secret"] = (
                        "not set"
                        if plain in ("", None, [], {})
                        else "placeholder"
                        if self.placeholder(vault_name, plain)
                        else "set"
                    )
                    if isinstance(plain, str) and len(plain) >= 4 and not self.identifier(vault_name):
                        self.hunted.add(plain)
                else:
                    row["value"] = plain
        settable, why, change = self.settable(name)
        if settable:
            row["change"] = f"just settings {settable} --value <value>"
        else:
            row["change"] = change or None
            row["why"] = why
        if where == "default" and isinstance(raw, str) and "{{" in raw:
            # The wiring, from a file in git: it holds no secret, whatever the value it makes does.
            row["wiring"] = raw
            row["wiring_in"] = (
                "inventory/group_vars/all/defaults.yml" if name in self.project else (f"roles/{role}/defaults/main.yml")
            )
        return row

    def role(self, role: str, only: str | None = None) -> list[dict]:
        entry_points = yaml.safe_load((REPO / "roles" / role / "meta" / "argument_specs.yml").read_text())
        entry_point = {}
        for each, spec in sorted(entry_points["argument_specs"].items(), key=lambda item: item[0] != "main"):
            for name in spec.get("options") or {}:
                entry_point.setdefault(name, each)
        rows = []
        for name, spec in self.specs[role].items():
            if only is None or name == only:
                rows.append(self.row(role, name, spec) | {"entry_point": entry_point[name]})
                if only:
                    described = spec.get("description") or ""
                    rows[-1]["description"] = " ".join(described) if isinstance(described, list) else str(described)
                    rows[-1]["default"] = spec.get("default")
        return rows

    def setting(self, name: str) -> dict:
        """One setting of local.yml.example, on the role whose variable it feeds."""
        fed = [docs.role_of(var, self.specs) for var in docs.set_by(name, self.feeds, self.specs)]
        role = next((each for each in fed if each), docs.role_of(name, self.specs) or "common")
        context = self.context(role)
        if name not in context["values"] and name in self.defaults:
            # A default that lives in a role's default() (vm_cores), or one setting's in another's (vm_memory_min_mb).
            default = self.defaults[name]
            context["values"][name] = trust_as_template(default) if isinstance(default, str) else default
        return self.row(role, name, {})

    def everything(self) -> list[dict]:
        rows = []
        proxmox = self.inventory.get_hosts("proxmox")
        address = proxmox[0].vars.get("ansible_host") if proxmox else None
        address = None if address is None else str(address)  # Ansible's tagged str, made plain
        example = yaml.safe_load((REPO / "inventory" / "hosts.yml.example").read_text())
        example = example["all"]["children"]["proxmox"]["hosts"]["pve"]["ansible_host"]
        rows.append(
            {
                "name": "ansible_host",
                "section": "Proxmox",
                "role": None,
                "set_in": "hosts.yml",
                "via": [],
                "kind": "placeholder" if address in (None, example) else "value",
                "value": None if address in (None, example) else address,
                "changed": address not in (None, example),
                "change": "inventory/hosts.yml",
            }
        )
        for title, groups in docs.parse_example(REPO / LOCAL.replace(".yml", ".yml.example"), secret=False):
            for _prose, found in groups:
                for name, _example in found:
                    rows.append(self.setting(name) | {"section": title})
        for title, groups in docs.parse_example(REPO / VAULT.replace(".yml", ".yml.example"), secret=True):
            for _prose, found in groups:
                for name, _example in found:
                    value = self.vault.get(name)
                    state = (
                        "not set" if value in ("", None) else "placeholder" if self.placeholder(name, value) else "set"
                    )
                    rows.append(
                        {
                            "name": name,
                            "section": f"Secrets: {title}",
                            "role": None,
                            "kind": "secret",
                            "value": None,
                            "secret": state,
                            "set_in": "vault.yml",
                            "via": [],
                            "changed": state == "set",
                            "change": "just vault",
                        }
                    )
        return rows

    def notes(self) -> list[str]:
        if not self.host_vars.is_dir():
            return []
        files = sorted(path.name for path in self.host_vars.iterdir() if path.suffix in (".yml", ".yaml"))
        if not files:
            return []
        return [
            f"inventory/host_vars/ holds {', '.join(files)}: Ansible applies each file to the VM of its name, which "
            "this report does not show (there is no per-VM setting: docs/reference/settings.md)."
        ]

    def check(self, rows: list[dict]) -> None:
        """Lock 5: nothing about to be printed holds a secret Ansible decrypted."""
        held = [
            row["name"]
            for row in rows
            if row.get("value") is not None
            and any(secret in json.dumps(row["value"]) or secret in str(row["value"]) for secret in self.hunted)
        ]
        if held:
            raise Refused(
                f"refusing to print a secret: {', '.join(held)} holds a value of the vault's. Nothing was printed"
            )


# ---------------------------------------------------------------------------------------------- the words ---
STYLE = {"local.yml": "y", "hosts.yml": "y", "vault.yml": "m"}


def shown(row: dict) -> str:
    kind = row["kind"]
    if kind == "secret":
        return {"set": "set (secret)", "not set": "not set", "placeholder": "the example's placeholder"}[row["secret"]]
    said = {
        "per_vm": "the VM's name",
        "on_the_vm": "worked out on the VM",
        "placeholder": "the example's placeholder",
        "at_run_start": f"when a run starts ({row.get('lookup', '').rsplit('.', 1)[-1]} lookup)",
    }
    if kind in said:
        return said[kind]
    value = row["value"]
    if value == "":
        return '""'
    dumped = yaml.safe_dump(value, default_flow_style=True, width=10_000).strip().removesuffix("...").strip()
    return text.one_line(dumped, 200)


def source(row: dict) -> tuple[str, str]:
    """Where a row was set, and its style: the person's own file in their colour, a default dim."""
    if row["via"]:
        first = row["via"][0]
        return f"{first['name']} in {first['file']}", STYLE.get(first["file"], "")
    return row["set_in"], STYLE.get(row["set_in"], "d")


def table(rows: list[dict], heading) -> list[list]:
    """Rows under their headings, every line within WIDTH. A value longer than its column is cut with "…" (the
    one-variable view shows it whole); a source that does not fit beside it goes whole to the next line, and each
    thing a run sets has a line of its own."""
    lines: list[list] = []
    names = min(max((len(row["name"]) for row in rows), default=10), 44)
    values = max(8, min(26, max((len(shown(row)) for row in rows), default=8)))
    current = None
    for row in rows:
        title = heading(row)
        if title != current:
            current = title
            lines.append([screen.seg(title, "h")])
        value = screen.cut([screen.seg(shown(row), "m" if row["kind"] == "secret" else "")], values)
        start = [screen.seg(f"  {row['name']:<{names}}  "), *screen.pad(value, values), screen.seg("  ")]
        where, style = source(row)
        if screen.width(start) + len(where) <= WIDTH:
            lines.append([*start, screen.seg(where, style)])
        else:
            lines += [
                screen.cut(start, WIDTH),
                [screen.seg("      "), screen.seg(text.one_line(where, WIDTH - 6), style)],
            ]
        lines += [[screen.seg("      · "), screen.seg(said, "c")] for said in row.get("set_by_run", [])]
    return lines


def tail(rows: list[dict]) -> list[list]:
    mine = sum(1 for row in rows if row.get("changed") and row["kind"] != "secret")
    secrets = sum(1 for row in rows if row.get("changed") and row["kind"] == "secret")
    said = f"{screen.plural(mine, 'setting')} set in your files, {screen.plural(secrets, 'secret')} set in vault.yml."
    return [
        [],
        *(
            [screen.seg(line, "d")]
            for line in screen.fill(
                f"{said} Change a setting with just settings <name> --value <value>, a secret with just vault.",
                WIDTH,
            )
        ),
    ]


def _field(label: str, said: str, style: str = "") -> list[list]:
    """A labelled field of the one-variable view, wrapped under its value."""
    pieces = screen.fill(said, WIDTH - 12)
    return [
        [screen.seg(f"  {label:<8}  " if index == 0 else " " * 12), screen.seg(piece, style)]
        for index, piece in enumerate(pieces)
    ]


def one(row: dict) -> list[list]:
    """One variable or setting, explained: its value, the chain of files that set it, what a run sets, its default,
    where to change it and what it does."""
    where = (
        f"role {row['role']}, entry point {row['entry_point']}" if row.get("entry_point") else row.get("section", "")
    )
    lines = [[screen.seg(row["name"], "h"), screen.seg(f"  {where}", "d")]]
    lines += _field("value", shown(row), "m" if row["kind"] == "secret" else "")
    chain = [(f"{each['name']} in {each['file']}", each["file"]) for each in row["via"]] or [
        (row["set_in"], row["set_in"])
    ]
    if row.get("wiring"):
        chain.append((f"{row['name']}: {json.dumps(row['wiring'])} in {row['wiring_in']}", "default"))
    for index, (link, file) in enumerate(chain):
        lines += _field("set by" if index == 0 else "", text.one_line(link, 400), STYLE.get(file, ""))
    for said in row.get("set_by_run", []):
        lines += _field("runs", said, "c")
    if "default" in row:
        lines += _field("default", '""' if row["default"] == "" else text.one_line(json.dumps(row["default"]), 200))
    lines += _field("change", row["change"] if not row.get("why") else f"{row['change'] or 'not here'}: {row['why']}")
    for piece in screen.fill(text.one_line(row.get("description") or "", 4000), WIDTH - 2):
        lines.append([screen.seg(f"  {piece}")])
    if row.get("role") and row.get("entry_point"):
        lines.append([screen.seg(f"  docs/reference/roles/{row['role']}.md", "d")])
    return lines


def usage(as_json: bool) -> int:
    """How to use it: the roles, from their argument_specs so a new one shows up by itself, and the options."""
    specs = docs.specs()
    roles = []
    for path in sorted((REPO / "roles").glob("*/meta/argument_specs.yml")):
        main = yaml.safe_load(path.read_text())["argument_specs"]["main"]
        role = path.parent.parent.name
        roles.append({"role": role, "description": main.get("short_description", ""), "variables": len(specs[role])})
    if as_json:
        print(json.dumps({"roles": roles, "options": ["NAME", "--all", "--changed", "--json", "--value"]}, indent=2))
        return 0
    lines = [
        [screen.seg("Each setting's value and where it was set, for one role, one variable or all of them.")],
        [screen.seg(f"Reads without changing anything; --value sets one in {LOCAL}, and a secret", "d")],
        [screen.seg("changes with just vault.", "d")],
        [],
        [screen.seg("Roles", "h"), screen.seg(" " * 77), screen.seg("variables", "d")],
        *([screen.seg(f"  {each['role']:<18} {each['description']:<66}{each['variables']:>4}")] for each in roles),
        [],
        [screen.seg("Usage", "h")],
        [
            screen.seg("  just settings <role>          every variable of one role       "),
            screen.seg("just settings tailscale", "d"),
        ],
        [
            screen.seg("  just settings <variable>      one variable, explained          "),
            screen.seg("just settings tailscale_ssh", "d"),
        ],
        [screen.seg("  just settings --all           every setting, and which secrets are set")],
        [
            screen.seg(
                "  just settings --changed       only what you changed: alone, all of it; with a role, that role's"
            )
        ],
        [screen.seg("  just settings ... --json      the same, as JSON on standard output")],
        [
            screen.seg("  just settings <name> --value <value>   set one in local.yml   "),
            screen.seg("just settings tailscale_ssh --value true", "d"),
        ],
    ]
    _print(lines)
    return 0


def written(settings: Settings, result: dict, as_json: bool, inventory: Path, password: str) -> int:
    """Say what --value wrote, and what that changes: read again from a fresh look at every file, so what outranks
    local.yml - a hosts.yml variable, a run - is said rather than missed."""
    target, asked = result["name"], result["asked"]
    fresh = Settings(inventory, password)
    role = docs.role_of(asked, fresh.specs)
    now = fresh.role(role, asked)[0] if role else fresh.setting(target)
    fresh.check([now])
    notes = []
    if result["wrote"] is None:
        notes.append(f"{LOCAL} sets it already, on line {result['line']}: nothing was written")
    else:
        if asked != target:
            notes.append(f"{asked} is set through {target}, the setting local.yml.example names for it")
        if now["kind"] == "value" and now["value"] != result["value"] and now["set_in"] != "local.yml":
            notes.append(f"but {now['set_in']} outranks local.yml: {asked} is still {shown(now)}")
        notes += [f"{said}, on the run that does" for said in now.get("set_by_run", [])]
        notes += fresh.applies(target)
    if as_json:
        print(json.dumps({"wrote": result, "now": now, "notes": notes}, indent=2))
        return 0
    lines = []
    if result["wrote"] is not None:
        head = f"wrote {result['wrote']} in {LOCAL}, {result['how']} (line {result['line']})"
        lines += [[screen.seg(piece, "y")] for piece in screen.fill(text.one_line(head, 1000), WIDTH)]
    for note in notes:
        lines += [[screen.seg("  " + piece)] for piece in screen.fill(note, WIDTH - 2)]
    _print(lines)
    return 0


def _print(lines: list[list]) -> None:
    color = sys.stdout.isatty() and not C.ANSIBLE_NOCOLOR
    for line in lines:
        print(screen.render(screen.cut(line, WIDTH), color))


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="just settings", add_help=False)
    parser.add_argument("--usage", action="store_true")
    parser.add_argument("--all", default="")
    parser.add_argument("--changed", default="")
    parser.add_argument("--json", default="")
    parser.add_argument("--value", default="")
    parser.add_argument("--vault-password-file", default="")
    # The tests' inventory; the recipe never passes it.
    parser.add_argument("--inventory", default=str(REPO / "inventory"))
    parser.add_argument("name", nargs="?", default="")
    args = parser.parse_args(argv)
    as_json = args.json == "true"
    if args.value and (not args.name or args.all == "true" or args.changed == "true"):
        print("just settings: --value sets one setting: just settings <name> --value <value>.", file=sys.stderr)
        return 1
    if args.usage or not (args.name or args.all == "true" or args.changed == "true"):
        return usage(as_json)
    # As ansible-playbook decides it: the file passed, else ANSIBLE_VAULT_PASSWORD_FILE or ansible.cfg's.
    password = args.vault_password_file or (C.DEFAULT_VAULT_PASSWORD_FILE or "")
    try:
        settings = Settings(Path(args.inventory), password)
        if args.value:
            return written(settings, settings.write(args.name, args.value), as_json, Path(args.inventory), password)
        if args.all == "true" or (args.changed == "true" and not args.name):
            rows, target = settings.everything(), {"kind": "all"}
        elif args.name in settings.specs:
            rows, target = settings.role(args.name), {"kind": "role", "name": args.name}
        else:
            role = docs.role_of(args.name, settings.specs)
            if role:
                rows = settings.role(role, args.name)
            elif args.name in settings.defaults or args.name in settings.example_vault or args.name == "ansible_host":
                rows = [row for row in settings.everything() if row["name"] == args.name]
            else:
                raise Refused(
                    f"{args.name} is neither a role ({', '.join(sorted(settings.specs))}) nor a variable or setting"
                )
            target = {"kind": "variable", "name": args.name}
        if args.changed == "true":
            rows = [row for row in rows if row.get("changed")]
        settings.check(rows)
    except Refused as refusal:
        print(f"just settings: {refusal}.", file=sys.stderr)
        return 1
    notes = settings.notes()
    if as_json:
        print(
            json.dumps(
                {"target": target, "changed_only": args.changed == "true", "settings": rows, "notes": notes}, indent=2
            )
        )
        return 0
    if target["kind"] == "variable":
        lines = one(rows[0])
    else:

        def heading(row):
            if "section" in row:
                return row["section"]
            if row.get("entry_point", "main") == "main":
                return row["role"]
            return f"{row['role']} · {row['entry_point']}"

        lines = table(rows, heading) if rows else [[screen.seg("Nothing here is changed from the defaults.", "d")]]
        lines += tail(rows)
    lines += [[], *([screen.seg(piece, "d")] for note in notes for piece in screen.fill(note, WIDTH))] if notes else []
    _print(lines)
    return 0


