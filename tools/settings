    _print(lines)
    return 0


def written(settings: Settings, result: dict, as_json: bool, inventory: Path, password: str) -> int:
    """Say what --value wrote, and what that changes: read again from a fresh look at every file, so what outranks
    local.yml - a hosts.yml variable, a run - is said rather than missed."""
    target, asked = result["name"], result["asked"]
    fresh = Settings(inventory, password)
    now = _now(fresh, asked, target)
    fresh.check([now] if now else [])
    notes = []
    if result["wrote"] is None:
        notes.append(f"{LOCAL} sets it already, on line {result['line']}: nothing was written")
    else:
        if result.get("by_hand"):
            notes.append(f"{LOCAL} sets {asked} itself, which outranks the setting that feeds it: written there")
        elif asked != target:
            notes.append(f"{asked} is set through {target}, the setting local.yml.example names for it")
        if now and now["kind"] == "value" and now["value"] != result["value"]:
            notes.append(f"but {source(now)[0]} outranks it: {asked} is still {shown(now)}")
        notes += [f"{said}, on the run that does" for said in (now or {}).get("set_by_run", [])]
        notes += fresh.applies(target)
    if as_json:
        print(json.dumps({"wrote": result, "now": now, "notes": notes}, indent=2))
        return 0
    lines = []
    if result["wrote"] is not None:
        head = f"wrote {result['wrote']} in {LOCAL}, {result['how']} (line {result['line']})"
        lines += [[screen.seg(piece, "y")] for piece in screen.fill(text.one_line(head, 1000), WIDTH)]
    for note in notes:
        lines += [[screen.seg("  " + piece)] for piece in screen.fill(note, WIDTH - 2)]
    _print(lines)
    return 0


def _now(fresh: Settings, asked: str, target: str) -> dict | None:
    """The row of what was asked, read again after a change; none for a name nothing but local.yml knew."""
    role = docs.role_of(asked, fresh.specs)
    if role:
        return fresh.role(role, asked)[0]
    if target in fresh.defaults or target in fresh.example_settings:
        return fresh.setting(target)
    return None


def resetted(result: dict, as_json: bool, inventory: Path, password: str) -> int:
    """Say what --reset took out of local.yml, and the value the setting has now, read again from every file."""
    target, asked = result["name"], result["asked"]
    fresh = Settings(inventory, password)
    now = _now(fresh, asked, target)
    if now:
        fresh.check([now])
    notes = []
    if not result["removed"]:
        notes.append(f"{LOCAL} does not set {target}, so it is at its default already: nothing was written")
    else:
        if now and now["kind"] == "value":
            notes.append(f"{asked} is now {shown(now)}, from {source(now)[0]}")
        by_hand = sorted(set(docs.set_by(target, fresh.feeds, fresh.specs)) & set(fresh.local))
        if by_hand:
            notes.append(
                f"but {LOCAL} sets {', '.join(by_hand)} itself, which outranks {target}: just settings "
                f"{by_hand[0]} --reset takes it out"
            )
        notes += fresh.applies(target)
    if as_json:
        print(json.dumps({"reset": result, "now": now, "notes": notes}, indent=2))
        return 0
    lines = []
    if result["removed"]:
        how = "its example's line back in its place" if result["restored"] else "its line taken out"
        head = f"reset {', '.join(result['removed'])} in {LOCAL}: {how} (line {result['line']})"
        lines += [[screen.seg(piece, "y")] for piece in screen.fill(head, WIDTH)]
    for note in notes:
        lines += [[screen.seg("  " + piece)] for piece in screen.fill(note, WIDTH - 2)]
    _print(lines)
    return 0


def _print(lines: list[list]) -> None:
    color = sys.stdout.isatty() and not C.ANSIBLE_NOCOLOR
    for line in lines:
        print(screen.render(screen.cut(line, WIDTH), color))


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="just settings", add_help=False)
    parser.add_argument("--usage", action="store_true")
    parser.add_argument("--all", default="")
    parser.add_argument("--changed", default="")
    parser.add_argument("--json", default="")
    parser.add_argument("--value", default="")
    parser.add_argument("--reset", default="")
    parser.add_argument("--vault-password-file", default="")
    # The tests' inventory; the recipe never passes it.
    parser.add_argument("--inventory", default=str(REPO / "inventory"))
    parser.add_argument("name", nargs="?", default="")
    args = parser.parse_args(argv)
    as_json = args.json == "true"
    resetting = args.reset == "true"
    if (args.value or resetting) and (not args.name or args.all == "true" or args.changed == "true"):
        print("just settings: --value and --reset each change one setting, named beside it.", file=sys.stderr)
        return 1
    if args.value and resetting:
        print("just settings: --value sets a value and --reset takes one out: one or the other.", file=sys.stderr)
        return 1
    if args.usage or not (args.name or args.all == "true" or args.changed == "true"):
        return usage(as_json)
    # As ansible-playbook decides it: the file passed, else ANSIBLE_VAULT_PASSWORD_FILE or ansible.cfg's.
    password = args.vault_password_file or (C.DEFAULT_VAULT_PASSWORD_FILE or "")
    try:
        settings = Settings(Path(args.inventory), password)
        if resetting:
            return resetted(settings.reset(args.name), as_json, Path(args.inventory), password)
        if args.value:
            return written(settings, settings.write(args.name, args.value), as_json, Path(args.inventory), password)
        if args.all == "true" or (args.changed == "true" and not args.name):
            rows, target = settings.everything(), {"kind": "all"}
        elif args.name in settings.specs:
            rows, target = settings.role(args.name), {"kind": "role", "name": args.name}
        else:
            role = docs.role_of(args.name, settings.specs)
            if role:
                rows = settings.role(role, args.name)
            elif settings.known(args.name):
                rows = [settings.one_setting(args.name)]
            else:
                raise Refused(settings.unknown(args.name))
            target = {"kind": "variable", "name": args.name}
        if args.changed == "true":
            rows = [row for row in rows if row.get("changed")]
        settings.check(rows)
    except Refused as refusal:
        print(f"just settings: {refusal}.", file=sys.stderr)
        return 1
    notes = settings.notes()
    if as_json:
        print(
            json.dumps(
                {"target": target, "changed_only": args.changed == "true", "settings": rows, "notes": notes}, indent=2
            )
        )
        return 0
    if target["kind"] == "variable" and not rows:
        lines = [[screen.seg(f"{args.name} is at its default: local.yml and vault.yml do not change it.", "d")]]
    elif target["kind"] == "variable":
        lines = one(rows[0])
    else:

        def heading(row):
            if "section" in row:
                return row["section"]
            if row.get("entry_point", "main") == "main":
                return row["role"]
            return f"{row['role']} · {row['entry_point']}"

        lines = table(rows, heading) if rows else [[screen.seg("Nothing here is changed from the defaults.", "d")]]
        lines += tail(rows)
    lines += [[], *([screen.seg(piece, "d")] for note in notes for piece in screen.fill(note, WIDTH))] if notes else []
    _print(lines)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
