LOCAL = "inventory/group_vars/all/local.yml"
VAULT = "inventory/group_vars/all/vault.yml"
# The lookups a value may run here: each reads, and none starts a program or writes a file.
SAFE_LOOKUPS = frozenset(
    f"ansible.builtin.{name}" for name in ("env", "file", "config", "vars", "first_found", "fileglob")
)
# The files a person edits, as the report names them.
USERS = ("hosts.yml", "vault.yml", "local.yml")
# What the justfile passes with -e that is no setting: the names given, and init's own.
NOT_SETTINGS = frozenset({"vm_name", "vm_project", "vm_session", "status_only", "init_given", "init_ask"})
WIDTH = 100
# What --value refuses in a value: an expression, which Ansible would template - run, for a lookup - and a control
# character or a line break, which no setting of one line holds.
TEMPLATE = re.compile(r"\{\{|\{%|\{#")
CONTROL = re.compile(r"[\x00-\x1f\x7f]")
# The roles configure.yml runs, which just deploy --only configure --tags <role> applies.
CONFIGURED = ("common", "vscode_server", "dev_tools", "claude_code", "github_projects", "tailscale")
# What each type takes, as a refusal says it.
TAKES = {
    "bool": "true or false (yes or no, on or off)",
    "int": "a whole number",
    "list": "a list: comma-separated (tag:a,tag:b) or as YAML ([tag:a, tag:b])",
    "dict": "a mapping, as YAML ({key: value}) or key=value,key=value",
}


def _load(stem: str, path: Path):
    """A module of this checkout by path, once, as claude_on_proxmox_<stem>, as every module here loads another."""
    name = f"claude_on_proxmox_{stem}"
    if name not in sys.modules:
        spec = importlib.util.spec_from_file_location(name, path)
        module = importlib.util.module_from_spec(spec)
        sys.modules[name] = module
        spec.loader.exec_module(module)
    return sys.modules[name]


