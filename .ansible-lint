---
# ansible-lint configuration. "production" is the strictest built-in profile.
profile: production

exclude_paths:
  - .venv/
  - .ansible/
  - .cache/
  - .vagrant/
  - .github/
  - tests/unit/

# Roles in this repo are meant to be used from this repo, not published to Galaxy.
offline: true

# Example files are copied into place by the user; treat them as regular YAML. The scenarios' shared files are task
# files but one, the playbook each scenario's prepare.yml imports first: the first kind whose glob matches wins.
kinds:
  - yaml: "**/*.yml.example"
  - inventory: "inventory/hosts.yml.example"
  - playbook: "tests/molecule/boot_wait.yml"
  - tasks: "tests/molecule/*.yml"

# The modules in playbooks/library/ import what they share from playbooks/module_utils/, and the args rule imports
# each of them in ansible-lint's own process, where no module_utils folder is on the path: the one file of this rules
# folder puts that one there, and holds no rule, so ansible-lint's own rules are kept.
rulesdir:
  - .config/ansible-lint-rules/
use_default_rules: true

enable_list:
  - args
  - empty-string-compare
  - no-log-password
  - no-same-owner
  - name[prefix]
  - yaml

# Do not warn about roles lacking Galaxy metadata that only matters for publishing.
skip_list:
  - galaxy[no-changelog]
  - galaxy[version-incorrect]
