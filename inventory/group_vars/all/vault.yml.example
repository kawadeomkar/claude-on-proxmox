---
# Copy to inventory/group_vars/all/vault.yml (git-ignored), fill in, then encrypt:
#
#   cp inventory/group_vars/all/vault.yml.example inventory/group_vars/all/vault.yml
#   echo 'a-long-random-passphrase' > .vault_pass && chmod 600 .vault_pass
#   make vault-encrypt
#
# Values are referenced indirectly (vault_* -> plain name) in defaults.yml so
# `grep` finds their usage and ansible-lint's naming conventions are satisfied.

# Proxmox API token secret for proxmox_api_user (default ansible@pve). See the
# README section "Creating the Proxmox API token" for the pveum commands that
# create a VM-scoped user, role and token.
vault_proxmox_api_token_secret: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# GitHub account whose repositories get cloned onto the VM.
vault_github_username: "your-github-username"
# Optional. With it, private repositories are listed and cloned and gh on each
# VM is signed in with it, so git push and gh pr create work there. A classic
# token needs repo, workflow and read:org; a fine-grained one Metadata (read)
# and Contents, Pull requests and Workflows (read and write) on all
# repositories. Leave it empty to sign in once per VM by GitHub's device flow
# instead (make github-login VM_NAME=<name>), with no secret here: that run
# clones the private repositories too, and later runs list with the token gh
# stored. README, "Private repositories, and pushing from the VM".
vault_github_token: ""

# Optional: skip interactive `claude` login on the VM.
# Billing for Claude Code on the VM via Anthropic API credits. Leave empty to
# log in with your Claude account instead - and leave it empty if you want
# Remote Control (claude_remote_control), which an API key would override.
vault_anthropic_api_key: ""
