---
# Copy to inventory/group_vars/all/local.yml (git-ignored). Anything set here
# overrides inventory/group_vars/all/defaults.yml. Uncomment only what differs
# so that future default changes still flow through.
#
#   cp inventory/group_vars/all/local.yml.example inventory/group_vars/all/local.yml

# Proxmox node name as shown in the PVE UI, and the storage for VM disks.
# proxmox_node: pve
# proxmox_storage: local-lvm
# Set to true after trusting the PVE CA on the controller (README).
# proxmox_validate_certs: true
# Which NIC of the template carries the LAN address: its MAC is how a VM's own
# address is told apart from bridges the guest grows later (docker0). Change it
# only if the template was built with something other than a single net0.
# proxmox_nic: net0

# Login user on the VM.
# vm_user: dev

# VM sizing. These apply to every VM a run creates - VMs are no longer listed
# in hosts.yml, so there is no per-VM override. Provision fleets that need
# different sizes in separate runs.
# vm_cores: 2
# vm_memory_mb: 4096
# vm_disk_size: 32G
# vm_nameservers: [1.1.1.1, 8.8.8.8]

# Addressing is DHCP by default and the guest agent reports back what it got.
# To pin an address instead, set the cloud-init ipconfig line directly. This is
# also fleet-wide: every VM a run provisions gets this same address, so use it
# only for a single VM, or one VM per run with a new value each time. (A router
# DHCP reservation is no substitute across rebuilds - every clone gets a new MAC.)
# proxmox_vm_ipconfig: "ip=192.0.2.60/24,gw=192.0.2.1"

# Which of your GitHub repositories to clone. The username itself lives in vault.yml.
# Leave github_projects empty to clone every repository of that user; list names
# to clone only those.
# github_projects: [personal-website, homeserver]
# github_projects_include_forks: false
# github_projects_include_archived: false
# github_projects_exclude: []
# github_projects_clone_protocol: https

# Packages/tools installed on the VM. See roles/*/defaults/main.yml for the full lists.
# common_extra_packages: [postgresql-client]
# dev_tools_install_docker: true
# dev_tools_install_node: true
# dev_tools_install_uv: true
# dev_tools_install_gh: true
# dev_tools_node_major: 22

# VS Code over SSH (README, "Using VS Code on the VM"). On the VM: an sshd
# drop-in with forwarding and keepalives, checked against what sshd runs
# with, and a higher inotify limit. Set false to remove both files.
# vscode_remote: true
# On this machine: an SSH alias per VM in ~/.ssh/claude-on-proxmox.conf,
# included from the top of ~/.ssh/config, so `ssh alpha` and VS Code's host
# picker follow the VM's address. Set false to keep out of ~/.ssh entirely;
# claude_ssh_config_include: false writes the file but not the Include line.
# claude_ssh_config: true
# claude_ssh_config_include: true
# Point aliases at <name>.<domain> instead of the address, on a network whose
# DNS resolves VM names; then a lease that moves no longer matters.
# claude_ssh_host_domain: lan
# claude_ssh_identity_file: ~/.ssh/id_ed25519
# Off on purpose: the VM user is root-equivalent and runs Claude Code, and
# agent forwarding hands them every key in your agent.
# claude_ssh_forward_agent: false
# claude_ssh_options:
#   ServerAliveInterval: "30"
# Where the code lives on the VM: cloned into, opened by Remote Control, and
# what VS Code is pointed at. Empty means ~/projects of the VM user.
# vm_projects_dir: ""
# `make code` opens a workspace file that starts claude in a terminal of the
# window, once you have trusted the folder and allowed automatic tasks. Set
# false to open the bare folder and write nothing on the VM; for one run,
# make code VM_NAME=alpha ANSIBLE_ARGS="-e vscode_claude_terminal=false".
# vscode_claude_terminal: true
# Where those files go on the VM. Empty: .claude-on-proxmox in vm_projects_dir.
# vscode_workspaces_dir: ""
# The VS Code settings read (never written) to say whether the terminal starts
# on its own. Empty: where VS Code keeps them on this OS.
# vscode_user_settings_file: ""

# Claude Code release channel: stable, latest, or an exact version like 2.1.0
# claude_code_version: stable
# Extra user-level settings merged into ~/.claude/settings.json
# claude_code_settings:
#   permissions:
#     defaultMode: acceptEdits

# Remote Control: put each VM's Claude Code session in the list at claude.ai/code
# and in the mobile app. On by default, and derived from the credentials on the
# VM (README, "Reaching a VM from your phone"). Set false to turn it off - also
# the answer when claude_code_settings.env carries a privacy setting such as
# DISABLE_TELEMETRY or DO_NOT_TRACK on purpose: those disable Remote Control,
# so the role leaves the service stopped and says so until one or the other goes.
# claude_remote_control: true
# Session title in the list at claude.ai/code; defaults to the VM name.
# claude_code_remote_control_name: "{{ inventory_hostname }}"
# Where sessions open. Empty means ~/projects of the VM user, where
# github_projects clones; it must not be the home directory itself.
# claude_code_remote_control_dir: ""
# Permission mode remote sessions start in, passed as --permission-mode, which
# outranks permissions.defaultMode in claude_code_settings.
# claude_code_remote_control_permission_mode: default
# same-dir: every session shares the directory above. worktree: each session
# gets its own git worktree (needs a repository there). session: serve one
# session and reject further connections.
# claude_code_remote_control_spawn: same-dir
