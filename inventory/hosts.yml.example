---
# make init copies this to inventory/hosts.yml (git-ignored) and asks for the
# Proxmox host's address, which it writes in place of 192.0.2.10 below. By hand:
#
#   cp inventory/hosts.yml.example inventory/hosts.yml
#
# The Proxmox host's address is the only address you have to supply. VMs are
# created by name (make deploy alpha), Proxmox assigns their VMIDs,
# your DHCP server assigns their addresses, and the QEMU guest agent reports
# those back - so VMs are never listed here.
all:
  children:
    proxmox:
      hosts:
        pve:
          ansible_host: 192.0.2.10 # IP of your Proxmox host (also used for the API)
          ansible_user: root

    # Left empty on purpose: provisioning adds VMs to this group at runtime,
    # and playbooks/discover.yml finds already-created ones by their tag.
    claude_vms:
      hosts: {}
