# {{ ansible_managed }}
# Put what `cargo install` builds on PATH for login shells, whether or not
# ~/.cargo/bin exists yet: rustup from Ubuntu's archive does not create it,
# and a program installed after login runs at once, in that shell and in a
# Claude Code session already started.
case ":$PATH:" in
  *":$HOME/.cargo/bin:"*) ;;
  *) PATH="$HOME/.cargo/bin:$PATH" ;;
esac
export PATH
